{
  "name": "janathan",
  "version": "1.0.0",
  "scripts": {
    "build:icons": "node scripts/copy-phosphor.mjs",
    "dev:css": "npx @tailwindcss/cli -i ./public/css/index.css -o ./public/css/app.css --watch",
    "dev:js": "npx esbuild public/js/index.js --bundle --outfile=public/js/app.js --watch",
    "dev": "npm run build:icons && npm run dev:css & npm run dev:js",
    "build:css": "npx @tailwindcss/cli -i ./public/css/index.css -o ./public/css/app.css --minify",
    "build:js": "npx esbuild public/js/index.js --bundle --minify --outfile=public/js/app.js",
    "build": "npm run build:icons && npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@alpinejs/focus": "^3.15.12",
    "alpinejs": "^3.15.12",
    "@phosphor-icons/web": "^2.1.2"
  }
}
