{% extends "layout.twig" %}

{% block title %}Setup - Janathan{% endblock %}

{% block nav %}{% endblock %}

{% block sidebar %}{% endblock %}

{% block content %}
<div class="flex min-h-[60vh] items-center justify-center">
    <div class="w-full max-w-sm">
        <div class="mb-6 flex flex-col items-center text-center">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-teal-500 text-white">
                <i class="ph ph-database text-2xl" aria-hidden="true"></i>
            </div>
            <h1 class="mt-4 text-2xl font-bold tracking-tight">Janathan</h1>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Initial setup</p>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
            <form method="post" action="{{ url_for('setup.install') }}" class="space-y-4">
                <div>
                    <label for="username" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Admin username</label>
                    <input type="text" id="username" name="username" required autocomplete="username"
                        value="{{ values.username|default('janathan') }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.username is defined %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    {% if errors.username is defined %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.username }}</p>{% endif %}
                </div>

                <div x-data="{ show: true }">
                    <label for="password" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Password</label>
                    <div class="relative">
                        <input :type="show ? 'text' : 'password'" id="password" name="password" required autocomplete="new-password"
                            value="1234"
                            class="block w-full rounded-lg border border-zinc-300 px-3 py-2 pr-10 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                        <button type="button" @click="show = !show"
                            class="absolute inset-y-0 right-0 flex w-9 items-center justify-center text-zinc-500 transition hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300"
                            :aria-label="show ? 'Hide password' : 'Show password'">
                            <i class="ph" :class="show ? 'ph-eye' : 'ph-eye-slash'" aria-hidden="true"></i>
                        </button>
                    </div>
                    {% if errors.password is defined %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.password }}</p>{% endif %}
                </div>

                <div x-data="{ show: true }">
                    <label for="password_confirm" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Confirm password</label>
                    <div class="relative">
                        <input :type="show ? 'text' : 'password'" id="password_confirm" name="password_confirm" required autocomplete="new-password"
                            value="1234"
                            class="block w-full rounded-lg border border-zinc-300 px-3 py-2 pr-10 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                        <button type="button" @click="show = !show"
                            class="absolute inset-y-0 right-0 flex w-9 items-center justify-center text-zinc-500 transition hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300"
                            :aria-label="show ? 'Hide password' : 'Show password'">
                            <i class="ph" :class="show ? 'ph-eye' : 'ph-eye-slash'" aria-hidden="true"></i>
                        </button>
                    </div>
                    {% if errors.password_confirm is defined %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.password_confirm }}</p>{% endif %}
                </div>

                <button type="submit"
                    class="w-full rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                        Complete setup
                    </button>
            </form>
        </div>

        <p class="mt-6 text-center text-xs text-zinc-400 dark:text-zinc-500">
            APP_KEY is generated automatically and stored in the database.
        </p>
    </div>
</div>
{% endblock %}
