{% extends "layout.twig" %}

{% block title %}{{ trans(isEdit ? 'hotspot.profile_form.title_edit' : 'hotspot.profile_form.title_add') }}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-2xl">
    <div>
        <a href="{{ url_for('hotspot.profiles') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
            {{ trans('hotspot.profile_form.back') }}
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ trans(isEdit ? 'hotspot.profile_form.edit_title' : 'hotspot.profile_form.add_title') }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {{ trans(isEdit ? 'hotspot.profile_form.edit_subtitle' : 'hotspot.profile_form.add_subtitle') }}
        </p>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
        {% if errorBanner %}
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200">
                <i class="ph ph-x-circle mt-0.5 flex-none text-xl text-red-500" aria-hidden="true"></i>
                <span>{{ errorBanner }}</span>
            </div>
        {% endif %}
        <form method="post" action="{{ url_for(formAction, formParams) }}" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.name') }}</label>
                <input type="text" id="name" name="name" required placeholder="{{ trans('hotspot.profile_form.name_ph') }}"
                    value="{{ values.name|default(profile.name|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.name %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.name %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.name }}</p>{% endif %}
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div
                    x-data="{
                        colors: ['#14b8a6','#10b981','#22c55e','#84cc16','#f59e0b','#f97316','#ef4444','#f43f5e','#ec4899','#d946ef','#8b5cf6','#6366f1','#3b82f6','#0ea5e9','#64748b'],
                        selected: '{{ values.color|default(profile.color|default('#14b8a6')) }}'
                    }">
                    <label class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.color') }}</label>
                    <input type="hidden" id="color" name="color" x-model="selected">
                    <div class="flex flex-wrap gap-2">
                        <template x-for="c in colors" :key="c">
                            <button type="button" @click="selected = c"
                                :class="selected.toLowerCase() === c.toLowerCase() ? 'ring-2 ring-offset-2 ring-zinc-500 dark:ring-offset-zinc-800' : 'ring-1 ring-inset ring-black/10 dark:ring-white/10'"
                                class="h-8 w-8 rounded-lg transition focus:outline-none focus:ring-2 focus:ring-teal-500"
                                :style="'background-color:' + c"
                                :aria-label="c" :title="c">
                                <i x-show="selected.toLowerCase() === c.toLowerCase()" class="ph ph-check text-base text-white" aria-hidden="true"></i>
                            </button>
                        </template>
                    </div>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.color_help') }}</p>
                    {% if errors.color %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.color }}</p>{% endif %}
                </div>

                <div>
                    <label for="price" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.price') }}</label>
                    <input type="number" id="price" name="price" step="0.01" min="0" placeholder="0" inputmode="decimal"
                        value="{{ values.price|default(profile.price|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.price %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.price_help') }}</p>
                    {% if errors.price %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.price }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="prefix" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.prefix') }}</label>
                <input type="text" id="prefix" name="prefix" placeholder="{{ trans('hotspot.generate.prefix_ph') }}" maxlength="100"
                    value="{{ values.prefix|default(profile.prefix|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.prefix %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.prefix_help') }}</p>
                {% if errors.prefix %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.prefix }}</p>{% endif %}
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="rate_limit" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.rate_limit') }}</label>
                    <input type="text" id="rate_limit" name="rate_limit" placeholder="10M/10M" autocomplete="off"
                        value="{{ values.rate_limit|default(profile.rate_limit|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.rate_limit %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.rate_limit_help') }}</p>
                    {% if errors.rate_limit %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.rate_limit }}</p>{% endif %}
                </div>

                <div>
                    <label for="shared_users" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.shared_users') }}</label>
                    <input type="number" id="shared_users" name="shared_users" min="1" max="255" required placeholder="1"
                        value="{{ values.shared_users|default(profile.shared_users|default('1')) }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.shared_users %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.shared_users_help') }}</p>
                    {% if errors.shared_users %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.shared_users }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="address_pool" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.address_pool') }}</label>
                {% set currentPool = values.address_pool|default(profile.address_pool|default('')) %}
                <select id="address_pool" name="address_pool"
                    class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.address_pool %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <option value="" {% if currentPool == '' %}selected{% endif %}>{{ trans('hotspot.profile_form.no_pool') }}</option>
                    {% for pool in pools %}
                        <option value="{{ pool }}" {% if currentPool == pool %}selected{% endif %}>{{ pool }}</option>
                    {% endfor %}
                </select>
                {% if errors.address_pool %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.address_pool }}</p>{% endif %}
            </div>

            <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="add_mac_cookie" name="add_mac_cookie" value="1"
                    {% if values.add_mac_cookie is defined ? values.add_mac_cookie : (profile.add_mac_cookie == 'true')|default(false) %}checked{% endif %}
                    class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                <span>
                    <span class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.mac_cookie') }}</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.mac_cookie_help') }}</span>
                </span>
            </label>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="validity_days" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.validity_days') }}</label>
                    <input type="number" id="validity_days" name="validity_days" min="1" max="3650" placeholder="—"
                        value="{{ values.validity_days|default(profile.validity_days|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.validity_days %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.validity_help') }}</p>
                    {% if errors.validity_days %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.validity_days }}</p>{% endif %}
                </div>

                <div>
                    <label for="start_on" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.profile_form.start_on') }}</label>
                    <select id="start_on" name="start_on"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.start_on %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                        <option value="first_login" {% if (values.start_on|default(profile.start_on|default('first_login'))) == 'first_login' %}selected{% endif %}>{{ trans('hotspot.profile_form.start_on_first_login') }}</option>
                        <option value="user_creation" {% if (values.start_on|default(profile.start_on|default('first_login'))) == 'user_creation' %}selected{% endif %}>{{ trans('hotspot.profile_form.start_on_user_creation') }}</option>
                    </select>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.profile_form.start_on_help') }}</p>
                    {% if errors.start_on %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.start_on }}</p>{% endif %}
                </div>
            </div>

            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <a href="{{ url_for('hotspot.profiles') }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">{{ trans('hotspot.cancel') }}</a>
            <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                {{ trans(isEdit ? 'hotspot.save_changes' : 'hotspot.profile_form.add') }}
            </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
