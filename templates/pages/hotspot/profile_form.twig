{% extends "layout.twig" %}

{% block title %}{{ isEdit ? 'Edit profile' : 'Add profile' }} - Hotspot - Janathan{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-2xl">
    <div>
        <a href="{{ url_for('hotspot.profiles') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="lni lni-arrow-left text-base" aria-hidden="true"></i>
            Back to profiles
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ isEdit ? 'Edit profile' : 'Add profile' }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {{ isEdit ? 'Update this hotspot user profile on the connected router.' : 'Create a new hotspot user profile on the connected router.' }}
        </p>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
        <form method="post" action="{{ url_for(formAction, formParams) }}" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Name</label>
                <input type="text" id="name" name="name" required placeholder="e.g. Voucher 10M"
                    value="{{ values.name|default(profile.name|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.name %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.name %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.name }}</p>{% endif %}
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="rate_limit" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Rate limit</label>
                    <input type="text" id="rate_limit" name="rate_limit" placeholder="10M/10M" autocomplete="off"
                        value="{{ values.rate_limit|default(profile.rate_limit|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.rate_limit %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">rx/tx, e.g. 10M/10M. Blank = unlimited.</p>
                    {% if errors.rate_limit %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.rate_limit }}</p>{% endif %}
                </div>

                <div>
                    <label for="shared_users" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Shared users</label>
                    <input type="number" id="shared_users" name="shared_users" min="1" max="255" required placeholder="1"
                        value="{{ values.shared_users|default(profile.shared_users|default('1')) }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.shared_users %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Max simultaneous logins per user.</p>
                    {% if errors.shared_users %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.shared_users }}</p>{% endif %}
                </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                <div>
                    <label for="idle_timeout" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Idle timeout</label>
                    <input type="text" id="idle_timeout" name="idle_timeout" placeholder="none" autocomplete="off"
                        value="{{ values.idle_timeout|default(profile.idle_timeout|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.idle_timeout %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    {% if errors.idle_timeout %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.idle_timeout }}</p>{% endif %}
                </div>

                <div>
                    <label for="session_timeout" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Session timeout</label>
                    <input type="text" id="session_timeout" name="session_timeout" placeholder="none" autocomplete="off"
                        value="{{ values.session_timeout|default(profile.session_timeout|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.session_timeout %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    {% if errors.session_timeout %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.session_timeout }}</p>{% endif %}
                </div>

                <div>
                    <label for="keepalive_timeout" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Keepalive timeout</label>
                    <input type="text" id="keepalive_timeout" name="keepalive_timeout" placeholder="none" autocomplete="off"
                        value="{{ values.keepalive_timeout|default(profile.keepalive_timeout|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.keepalive_timeout %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Use 30m, 1h or none.</p>
                    {% if errors.keepalive_timeout %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.keepalive_timeout }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="addresses_pool" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Address pool</label>
                <input type="text" id="addresses_pool" name="addresses_pool" placeholder="dhcp_pool1" autocomplete="off"
                    value="{{ values.addresses_pool|default(profile.addresses_pool|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.addresses_pool %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.addresses_pool %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.addresses_pool }}</p>{% endif %}
            </div>

            <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="mac_cookie" name="mac_cookie" value="1"
                    {% if values.mac_cookie is defined ? values.mac_cookie : profile.mac_cookie|default(false) %}checked{% endif %}
                    class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                <span>
                    <span class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">MAC cookie</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">Remember this user's device so it skips the login page on return visits.</span>
                </span>
            </label>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="on_login" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">On-login script</label>
                    <textarea id="on_login" name="on_login" rows="4" placeholder=":local id &#10;/ip/hotspot/active/set..."
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.on_login %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">{{ values.on_login|default(profile.on_login|default('')) }}</textarea>
                    {% if errors.on_login %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.on_login }}</p>{% endif %}
                </div>

                <div>
                    <label for="on_logout" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">On-logout script</label>
                    <textarea id="on_logout" name="on_logout" rows="4" placeholder=":local id &#10;/ip/hotspot/active/set..."
                        class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.on_logout %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">{{ values.on_logout|default(profile.on_logout|default('')) }}</textarea>
                    {% if errors.on_logout %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.on_logout }}</p>{% endif %}
                </div>
            </div>

            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <a href="{{ url_for('hotspot.profiles') }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">Cancel</a>
                <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                    {{ isEdit ? 'Save changes' : 'Add profile' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
