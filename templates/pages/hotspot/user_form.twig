{% extends "layout.twig" %}

{% block title %}{{ trans(isEdit ? 'hotspot.user_form.title_edit' : 'hotspot.user_form.title_add') }}{% endblock %}

{% block content %}
{% set backUrl = listBackUrl|default(url_for('hotspot.users')) %}
<div class="mx-auto w-full max-w-2xl">
    <div>
        <a href="{{ backUrl }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
            {{ trans('hotspot.user_form.back') }}
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ trans(isEdit ? 'hotspot.user_form.edit_title' : 'hotspot.user_form.add_title') }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {{ trans(isEdit ? 'hotspot.user_form.edit_subtitle' : 'hotspot.user_form.add_subtitle') }}
        </p>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
        {% if errorBanner %}
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200">
                <i class="ph ph-x-circle mt-0.5 flex-none text-xl text-red-500" aria-hidden="true"></i>
                <span>{{ errorBanner }}</span>
            </div>
        {% endif %}
        <form method="post" action="{{ url_for(formAction, formParams) }}" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="list_filter_q" value="{{ listFilters.q|default('') }}">
            <input type="hidden" name="list_filter_profile" value="{{ listFilters.profile|default('') }}">
            <input type="hidden" name="list_filter_comment" value="{{ listFilters.comment|default('') }}">
            <input type="hidden" name="list_filter_status" value="{{ listFilters.status|default('all') }}">

            <div>
                <label for="server" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.server') }}</label>
                {% set currentServer = values.server is defined ? values.server : user.server|default('all') %}
                <select id="server" name="server" required
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.server %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <option value="all" {% if currentServer == 'all' %}selected{% endif %}>{{ trans('hotspot.user_form.all_servers') }}</option>
                    {% for server in servers %}
                        <option value="{{ server }}" {% if currentServer == server %}selected{% endif %}>{{ server }}</option>
                    {% endfor %}
                </select>
                {% if errors.server %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.server }}</p>{% endif %}
            </div>

            <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.name') }}</label>
                <input type="text" id="name" name="name" required placeholder="{{ trans('hotspot.user_form.name_ph') }}" autocomplete="off"
                    value="{{ values.name|default(user.name|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.name %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.name %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.name }}</p>{% endif %}
            </div>

            <div>
                <label for="password" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.password') }}</label>
                <input type="password" id="password" name="password" {% if not isEdit %}required{% endif %} placeholder="{{ isEdit ? trans('hotspot.user_form.password_edit_ph') : '' }}" autocomplete="new-password"
                    value=""
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.password %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if isEdit %}
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.user_form.password_help') }}</p>
                {% endif %}
                {% if errors.password %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.password }}</p>{% endif %}
            </div>

            <div>
                <label for="profile" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.profile') }}</label>
                {% set currentProfile = values.profile|default(user.profile|default('')) %}
                <select id="profile" name="profile" required
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.profile %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <option value="" {% if currentProfile == '' %}selected{% endif %}>{{ trans('hotspot.user_form.select_profile') }}</option>
                    {% for p in profiles %}
                        <option value="{{ p }}" {% if currentProfile == p %}selected{% endif %}>{{ p }}</option>
                    {% endfor %}
                </select>
                {% if errors.profile %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.profile }}</p>{% endif %}
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="limit_uptime" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.limit_uptime') }}</label>
                    <input type="text" id="limit_uptime" name="limit_uptime" placeholder="{{ trans('hotspot.user_form.limit_uptime_ph') }}" autocomplete="off"
                        value="{{ values.limit_uptime is defined ? values.limit_uptime : user.limit_uptime|default('') }}" aria-describedby="limit_uptime_help"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.limit_uptime %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p id="limit_uptime_help" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.user_form.limit_uptime_help') }}</p>
                    {% if errors.limit_uptime %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.limit_uptime }}</p>{% endif %}
                </div>
                <div>
                    <label for="data_limit" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.data_limit') }}</label>
                    <div class="flex w-full overflow-hidden rounded-lg border bg-white focus-within:border-teal-500 focus-within:ring-2 focus-within:ring-teal-500/30 dark:bg-zinc-900 dark:focus-within:border-teal-500 {% if errors.data_limit %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                        <input type="number" id="data_limit" name="data_limit" min="0" step="0.5" inputmode="decimal" placeholder="{{ trans('hotspot.user_form.data_limit_ph') }}"
                            value="{{ values.data_limit is defined ? values.data_limit : user.data_limit|default('') }}" aria-describedby="data_limit_help"
                            class="min-w-0 flex-1 border-0 bg-transparent px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:bg-teal-50/50 focus:outline-none focus:ring-0 dark:text-zinc-100 dark:focus:bg-zinc-800">
                        <span class="w-px shrink-0 self-stretch bg-zinc-300 dark:bg-zinc-600" aria-hidden="true"></span>
                        {% set currentDataLimitUnit = values.data_limit_unit is defined ? values.data_limit_unit : user.data_limit_unit|default('MB') %}
                        <label for="data_limit_unit" class="sr-only">{{ trans('hotspot.user_form.data_limit_unit') }}</label>
                        <select id="data_limit_unit" name="data_limit_unit" aria-describedby="data_limit_help"
                            class="w-16 shrink-0 border-0 bg-zinc-50 px-2 py-2 text-sm text-zinc-900 focus:bg-teal-50 focus:outline-none focus:ring-0 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:bg-zinc-700">
                            <option value="MB" {% if currentDataLimitUnit == 'MB' %}selected{% endif %}>MB</option>
                            <option value="GB" {% if currentDataLimitUnit == 'GB' %}selected{% endif %}>GB</option>
                            {% if currentDataLimitUnit == 'B' %}<option value="B" selected>{{ trans('hotspot.user_form.data_limit_bytes') }}</option>{% endif %}
                        </select>
                    </div>
                    <p id="data_limit_help" class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.user_form.data_limit_help') }}</p>
                    {% if errors.data_limit %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.data_limit }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="comment" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.comment') }}</label>
                <input type="text" id="comment" name="comment" placeholder="{{ trans('hotspot.user_form.comment_ph') }}"
                    value="{{ values.comment|default(user.comment|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.comment %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.comment %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.comment }}</p>{% endif %}
            </div>

            <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="disabled" name="disabled" value="1"
                    {% if values.disabled is defined ? values.disabled : (user.disabled|default(false)) %}checked{% endif %}
                    class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                <span>
                    <span class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.user_form.disabled_label') }}</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.user_form.disabled_help') }}</span>
                </span>
            </label>

            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <a href="{{ backUrl }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">{{ trans('hotspot.cancel') }}</a>
            <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                {{ trans(isEdit ? 'hotspot.save_changes' : 'hotspot.user_form.add') }}
            </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
