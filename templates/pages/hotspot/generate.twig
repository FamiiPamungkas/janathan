{% extends "layout.twig" %}

{% block title %}{{ trans('hotspot.generate.title') }}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-2xl">
    <div>
        <a href="{{ url_for('hotspot.users') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
            {{ trans('hotspot.generate.back') }}
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ trans('hotspot.generate.heading') }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {{ trans('hotspot.generate.subtitle') }}
        </p>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
        {% if errorBanner %}
            <div class="mb-5 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200">
                <i class="ph ph-x-circle mt-0.5 flex-none text-xl text-red-500" aria-hidden="true"></i>
                <span>{{ errorBanner }}</span>
            </div>
        {% endif %}
        {% set charLower = values.char_lowercase is defined ? values.char_lowercase : true %}
        {% set charUpper = values.char_uppercase is defined ? values.char_uppercase : false %}
        {% set charNumbers = values.char_numbers is defined ? values.char_numbers : true %}
        <form method="post" action="{{ url_for(formAction) }}"
            x-data="{ sameAsUser: {{ values.password_same_as_username|default(false) ? 'true' : 'false' }}, charLower: {{ charLower ? 'true' : 'false' }}, charUpper: {{ charUpper ? 'true' : 'false' }}, charNumbers: {{ charNumbers ? 'true' : 'false' }}, charsetError: {{ errors.character ? 'true' : 'false' }} }"
            @submit="charsetError = !(charLower || charUpper || charNumbers); if (charsetError) $event.preventDefault()"
            class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="qty" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.quantity') }}</label>
                    <input type="number" id="qty" name="qty" min="1" max="1000" required placeholder="10" inputmode="numeric"
                        value="{{ values.qty|default('') }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.qty %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    {% if errors.qty %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.qty }}</p>{% endif %}
                </div>

                <div>
                    <label for="profile" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.profile') }}</label>
                    <select id="profile" name="profile" required
                        @change="$refs.prefix.value = $event.target.selectedOptions[0]?.dataset.prefix || ''"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.profile %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                        <option value="" data-prefix="" {% if (values.profile|default('')) == '' %}selected{% endif %}>{{ trans('hotspot.generate.select_profile') }}</option>
                        {% for p in profiles %}
                            <option value="{{ p }}" data-prefix="{{ prefixMap[p]|default('') }}" {% if (values.profile|default('')) == p %}selected{% endif %}>{{ p }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.profile %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.profile }}</p>{% endif %}
                </div>
            </div>

            <div>
                <label for="prefix" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.prefix') }}</label>
                <input type="text" id="prefix" name="prefix" x-ref="prefix" placeholder="{{ trans('hotspot.generate.prefix_ph') }}" maxlength="100"
                    value="{{ values.prefix|default('') }}"
                    class="block w-full rounded-lg border px-3 py-2 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.prefix %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.generate.prefix_help') }}</p>
                {% if errors.prefix %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.prefix }}</p>{% endif %}
            </div>

            <fieldset>
                <legend class="mb-1.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.char_set') }}</legend>
                <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-x-5 sm:gap-y-2">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="char_uppercase" name="char_uppercase" value="1"
                               x-model="charUpper"
                               @change="charsetError = !(charLower || charUpper || charNumbers)"
                               {% if charUpper %}checked{% endif %}
                               class="h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.char_uppercase') }}</span>
                        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">(ABC)</span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="char_lowercase" name="char_lowercase" value="1"
                            x-model="charLower"
                            @change="charsetError = !(charLower || charUpper || charNumbers)"
                            {% if charLower %}checked{% endif %}
                            class="h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.char_lowercase') }}</span>
                        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">(abc)</span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="char_numbers" name="char_numbers" value="1"
                            x-model="charNumbers"
                            @change="charsetError = !(charLower || charUpper || charNumbers)"
                            {% if charNumbers %}checked{% endif %}
                            class="h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                        <span class="text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.char_numbers') }}</span>
                        <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">(123)</span>
                    </label>
                </div>
                <p x-show="charsetError" x-cloak class="mt-1 text-xs text-red-600 dark:text-red-400">{{ trans('hotspot.generate.char_set_required') }}</p>
            </fieldset>

            <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" id="password_same_as_username" name="password_same_as_username" value="1"
                    x-model="sameAsUser"
                    {% if values.password_same_as_username|default(false) %}checked{% endif %}
                    class="mt-0.5 h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                <span>
                    <span class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.pass_same_label') }}</span>
                    <span class="block text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.generate.pass_same_help') }}</span>
                </span>
            </label>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="name_length" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.name_length') }}</label>
                    <select id="name_length" name="name_length"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.name_length %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                        {% set currentName = values.name_length|default(4) %}
                        {% for len in [4, 6, 8, 10, 12, 16, 20, 24] %}
                            <option value="{{ len }}" {% if currentName == len %}selected{% endif %}>{{ trans('hotspot.generate.chars', {count: len}) }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.name_length %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.name_length }}</p>{% endif %}
                </div>

                <div x-show="!sameAsUser" x-cloak>
                    <label for="password_length" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.pass_length') }}</label>
                    <select id="password_length" name="password_length"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.password_length %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                        {% set currentPass = values.password_length|default(4) %}
                        {% for len in [4, 6, 8, 10, 12, 16, 20, 24] %}
                            <option value="{{ len }}" {% if currentPass == len %}selected{% endif %}>{{ trans('hotspot.generate.chars', {count: len}) }}</option>
                        {% endfor %}
                    </select>
                    {% if errors.password_length %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.password_length }}</p>{% endif %}
                </div>
            </div>

            <div>
                    <label for="comment" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('hotspot.generate.comment_label') }}</label>
                    <input type="text" id="comment" name="comment" placeholder="{{ trans('hotspot.generate.comment_ph') }}" maxlength="4096"
                        value="{{ values.comment|default('') }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.comment %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.generate.comment_help') }}</p>
                {% if errors.comment %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.comment }}</p>{% endif %}
            </div>

            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <a href="{{ url_for('hotspot.users') }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">{{ trans('hotspot.cancel') }}</a>
            <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                {{ trans('hotspot.generate.submit') }}
            </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
