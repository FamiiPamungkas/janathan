{% extends "layout.twig" %}

{% block title %}Profile List - Hotspot - Janathan{% endblock %}

{% block content %}
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Profile List</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="inline-flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-teal-500"></span>
                </span>
                {{ router.name }}
            </span>
            <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
            <span class="font-mono">{{ router.host }}:{{ router.port }}</span>
        </p>
    </div>
    <a href="{{ url_for('hotspot.profiles.create') }}"
        class="inline-flex w-fit items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
        <i class="lni lni-plus text-base" aria-hidden="true"></i>
        Add profile
    </a>
</div>

{% if not hotspotAvailable %}
<div class="mt-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
    <i class="lni lni-info mt-0.5 flex-none text-xl" aria-hidden="true"></i>
    <div>
        <p class="text-sm font-semibold">Hotspot is not available on this router</p>
        <p class="mt-0.5 text-sm">Profiles cannot be listed. Check that the hotspot package is installed and configured, and that the API user has permission to read it.</p>
    </div>
</div>
{% endif %}

{% if profiles is empty %}
<div class="mt-8 flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-800">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-700/50">
        <i class="lni lni-gear-1 text-2xl text-zinc-400" aria-hidden="true"></i>
    </div>
    <h2 class="mt-4 text-base font-semibold">No profiles found</h2>
    <p class="mt-1 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">
        This router has no hotspot user profiles. Create one from the router's hotspot configuration.
    </p>
</div>
{% else %}
<!-- Mobile: stacked cards -->
<div class="mt-6 grid grid-cols-1 gap-3 md:hidden">
    {% for profile in profiles %}
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                <i class="lni lni-gear-1 text-xl" aria-hidden="true"></i>
            </div>
            <div class="min-w-0">
                <p class="truncate font-semibold">{{ profile.name }}</p>
            </div>
        </div>
        <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 text-sm">
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Rate Limit</dt>
                <dd class="truncate font-mono text-xs text-zinc-600 dark:text-zinc-400">{{ profile.rate_limit }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Shared users</dt>
                <dd class="font-medium tabular-nums">{{ profile.shared_users }}</dd>
            </div>
        </dl>
        <div class="mt-4 flex items-center gap-2">
            <a href="{{ url_for('hotspot.users') }}?profile={{ profile.name|url_encode }}" title="View users" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="lni lni-user-multiple-4 text-xl" aria-hidden="true"></i>
            </a>
            <a href="{{ url_for('hotspot.profiles.edit', {id: profile.id}) }}" title="Edit" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="lni lni-pencil-1 text-xl" aria-hidden="true"></i>
            </a>
            <form method="post" action="{{ url_for('hotspot.profiles.delete', {id: profile.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove profile &quot;{{ profile.name }}&quot;?')) $event.preventDefault()">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" title="Remove" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                    <i class="lni lni-trash-3 text-xl" aria-hidden="true"></i>
                </button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Desktop: table -->
<div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block">
    <div class="overflow-x-auto">
        <table class="min-w-full align-middle text-sm">
            <thead>
                <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Name</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Rate Limit</th>
                    <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">Shared Users</th>
                    <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for profile in profiles %}
                <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-teal-50 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ profile.name|first|upper }}</span>
                            <span class="font-medium">{{ profile.name }}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 font-mono text-xs text-zinc-600 dark:text-zinc-400">{{ profile.rate_limit }}</td>
                    <td class="px-4 py-3 text-end font-medium tabular-nums">{{ profile.shared_users }}</td>
                    <td class="px-4 py-3">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ url_for('hotspot.users') }}?profile={{ profile.name|url_encode }}" title="View users" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                <i class="lni lni-user-multiple-4 text-xl" aria-hidden="true"></i>
                            </a>
                            <a href="{{ url_for('hotspot.profiles.edit', {id: profile.id}) }}" title="Edit" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                <i class="lni lni-pencil-1 text-xl" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ url_for('hotspot.profiles.delete', {id: profile.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove profile &quot;{{ profile.name }}&quot;?')) $event.preventDefault()">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" title="Remove" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                                    <i class="lni lni-trash-3 text-xl" aria-hidden="true"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
