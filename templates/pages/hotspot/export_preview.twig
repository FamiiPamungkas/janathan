{% extends "layout.twig" %}

{% block title %}Export Preview - Janathan{% endblock %}

{% block content %}
{% if error is defined and error %}
<div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200">
    <p class="flex items-start gap-2">
        <i class="ph ph-x-circle flex-none text-lg text-red-500" aria-hidden="true"></i>
        <span>{{ error }}</span>
    </p>
</div>
<div class="mt-4">
    <a href="{{ backUrl }}"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
        <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
        Back
    </a>
</div>
{% else %}
{% set isScript = format == 'rsc' %}
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Export preview</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            {% if isScript %}Mikrotik script (.rsc){% else %}CSV file{% endif %}
            <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
            <span class="font-medium tabular-nums text-zinc-700 dark:text-zinc-300">{{ users|length }}</span>
            user{% if users|length != 1 %}s{% endif %}
        </p>
    </div>
    <div class="flex items-center gap-2">
        <a href="{{ backUrl }}"
            class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
            <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
            Back
        </a>
        <button type="button"
            @click='exportBlob({{ downloadContent|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}, {{ downloadFilename|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}, {{ downloadMime|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }})'
            class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-3.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
            <i class="ph ph-download-simple text-base" aria-hidden="true"></i>
            Download
        </button>
    </div>
</div>

<div class="mt-6 rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800">
    {% if isScript %}
    <pre class="max-h-[70vh] overflow-auto p-4 text-xs leading-relaxed text-zinc-800 dark:text-zinc-200"><code>{{ scriptText|escape }}</code></pre>
    {% else %}
    <div class="max-h-[70vh] overflow-auto">
        <table class="min-w-full text-sm">
            <thead>
                <tr class="border-b border-zinc-200 text-start font-semibold text-zinc-600 dark:border-zinc-700 dark:text-zinc-300">
                    <th class="px-4 py-3 text-start">Name</th>
                    <th class="px-4 py-3 text-start">Password</th>
                    <th class="px-4 py-3 text-start">Profile</th>
                    <th class="px-4 py-3 text-start">Comment</th>
                    <th class="px-4 py-3 text-start">Disabled</th>
                    <th class="px-4 py-3 text-start">Server</th>
                    <th class="px-4 py-3 text-start">MAC</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                <tr class="border-b border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                    <td class="px-4 py-2 font-mono">{{ u.name|escape }}</td>
                    <td class="px-4 py-2 font-mono">{{ u.password|escape }}</td>
                    <td class="px-4 py-2">{{ u.profile|escape }}</td>
                    <td class="px-4 py-2">{{ u.comment|escape }}</td>
                    <td class="px-4 py-2">{{ u.disabled ? 'yes' : 'no' }}</td>
                    <td class="px-4 py-2">{{ u.server|escape }}</td>
                    <td class="px-4 py-2 font-mono">{{ u.mac_address|escape }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endif %}
{% endblock %}
