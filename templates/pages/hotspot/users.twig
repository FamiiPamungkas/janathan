                        </div>
                        <div>
                            <template x-if="detailUser.expired && !detailUser.disabled">
                                <span class="inline-flex items-center rounded-md bg-red-100 px-2.5 py-1 text-xs font-medium text-red-700 dark:bg-red-500/15 dark:text-red-300">{{ trans('hotspot.users.expired') }}</span>
                            </template>
                            <template x-if="detailUser.disabled">
                                <span class="inline-flex items-center rounded-md bg-zinc-100 px-2.5 py-1 text-xs font-medium text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300">{{ trans('hotspot.status_disabled') }}</span>
                            </template>
                            <template x-if="!detailUser.expired && !detailUser.disabled">
                                <span class="inline-flex items-center rounded-md bg-teal-50 px-2.5 py-1 text-xs font-medium text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ trans('hotspot.status_enabled') }}</span>
                            </template>
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="mt-4 rounded-lg border border-zinc-200 bg-zinc-50 p-3 dark:border-zinc-700 dark:bg-zinc-700/20">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.password') }}</span>
                            <button type="button" @click="showPassword = !showPassword"
                                class="inline-flex items-center justify-center gap-1.5 rounded-md border border-zinc-200 bg-white px-2.5 py-1 text-xs font-medium text-zinc-600 transition hover:border-zinc-300 hover:text-zinc-800 dark:border-zinc-600 dark:bg-transparent dark:text-zinc-400 dark:hover:border-zinc-500 dark:hover:text-zinc-200"
                                :aria-label="showPassword ? 'Hide password' : 'Show password'">
                                <i class="ph text-sm" :class="showPassword ? 'ph-eye-slash' : 'ph-eye'" aria-hidden="true"></i>
                                <span x-text="showPassword ? 'Hide' : 'Show'"></span>
                            </button>
                        </div>
                        <p class="mt-1.5 font-mono text-sm text-zinc-900 dark:text-zinc-100">
                            <span x-show="!showPassword">••••••••</span>
                            <span x-show="showPassword" x-text="detailUser.password" class="break-all"></span>
                        </p>
                    </div>

                    <!-- Details section -->
                    <div class="mt-5 border-t border-zinc-100 pt-4 dark:border-zinc-700/50">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.detail_title') }}</p>
                        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_comment') }}</dt>
                                <dd class="mt-0.5 text-sm text-zinc-900 break-words dark:text-zinc-100" x-text="detailUser.comment || '—'"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_expires') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.expires_at || '—'"></dd>
                            </div>
                            <div class="sm:col-span-2">
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.server') }}</dt>
                                <dd class="mt-0.5 text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.server || '{{ trans('hotspot.users.no_limit') }}'"></dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Connection section -->
                    <div class="mt-5 border-t border-zinc-100 pt-4 dark:border-zinc-700/50">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.mac_address') }}</p>
                        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                            <div class="sm:col-span-2">
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.mac_address') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.mac_address || '—'"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.limit_in') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.limit_bytes_in || '{{ trans('hotspot.users.no_limit') }}'"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.limit_out') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.limit_bytes_out || '{{ trans('hotspot.users.no_limit') }}'"></dd>
                            </div>
                        </dl>
                    </div>

                    <!-- Traffic section -->
                    <div class="mt-5 border-t border-zinc-100 pt-4 dark:border-zinc-700/50">
                        <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_uptime') }}</p>
                        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_uptime') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.uptime || '—'"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_bytes_in') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.bytes_in"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.th_bytes_out') }}</dt>
                                <dd class="mt-0.5 font-mono text-sm text-zinc-900 dark:text-zinc-100" x-text="detailUser.bytes_out"></dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>
</div>
{% endif %}
{% endblock %}
