{% extends "layout.twig" %}

{% block title %}{{ trans('hotspot.users.title') }}{% endblock %}

{% block content %}
{% set profileFilter = filters.profile|default('') %}
{% set hasFilters = filtersActive|default(false) %}
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" x-data="{ exportModal: false }">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">{{ trans('hotspot.users.heading') }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="inline-flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-teal-500"></span>
                </span>
                {{ router.name }}
            </span>
            <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
            <span class="font-mono">{{ router.host }}:{{ router.port }}</span>
        </p>
    </div>
    <div class="flex w-fit items-center gap-2">
        {% if users is not empty %}
        <button type="button" @click="exportModal = true"
            class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-sm font-semibold text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
            <i class="ph ph-export text-base" aria-hidden="true"></i>
            {{ trans('hotspot.users.export') }}
        </button>
        {% endif %}
        <a href="{{ url_for('hotspot.users.create') }}{% if profileFilter %}?profile={{ profileFilter|url_encode }}{% endif %}"
            class="inline-flex w-fit items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
            <i class="ph ph-plus text-base" aria-hidden="true"></i>
            {{ trans('hotspot.users.add') }}
        </a>
    </div>
    {% if users is not empty %}
    <div x-show="exportModal" x-cloak class="fixed inset-0 z-50 flex items-end justify-center bg-zinc-900/50 p-4 sm:items-center" x-transition.opacity>
        <div class="w-full max-w-sm rounded-xl border border-zinc-200 bg-white shadow-xl dark:border-zinc-700 dark:bg-zinc-800"
             @click.outside="exportModal = false" x-transition>
            <div class="flex items-center justify-between border-b border-zinc-100 px-4 py-3 dark:border-zinc-700/50">
                <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.export_title') }}</h2>
                <button type="button" @click="exportModal = false"
                    class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 transition hover:bg-zinc-100 dark:hover:bg-zinc-700" title="{{ trans('hotspot.close') }}">
                    <i class="ph ph-x text-xl" aria-hidden="true"></i>
                </button>
            </div>
            <p class="px-4 pt-3 text-xs text-zinc-500 dark:text-zinc-400">
                {{ trans('hotspot.users.export_help', {count: users|length}) }}
            </p>
            <div class="flex flex-col gap-1 p-3">
                <a href="{{ url_for('hotspot.users.export') }}?q={{ filters.q|url_encode }}&profile={{ filters.profile|url_encode }}&comment={{ filters.comment|url_encode }}&status={{ filters.status|url_encode }}&format=csv&preview=1"
                    target="_blank" @click="exportModal = false"
                    class="flex items-center justify-between rounded-lg border border-zinc-200 bg-white px-3.5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-teal-300 hover:bg-teal-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-teal-500/40 dark:hover:bg-teal-500/10">
                    <span class="inline-flex items-center gap-2">
                        <i class="ph ph-table text-base text-zinc-400" aria-hidden="true"></i>
                        {{ trans('hotspot.users.csv') }}
                    </span>
                    <i class="ph ph-arrow-square-out text-base text-zinc-400" aria-hidden="true"></i>
                </a>
                <a href="{{ url_for('hotspot.users.export') }}?q={{ filters.q|url_encode }}&profile={{ filters.profile|url_encode }}&comment={{ filters.comment|url_encode }}&status={{ filters.status|url_encode }}&format=rsc&preview=1"
                    target="_blank" @click="exportModal = false"
                    class="flex items-center justify-between rounded-lg border border-zinc-200 bg-white px-3.5 py-2.5 text-sm font-medium text-zinc-700 transition hover:border-teal-300 hover:bg-teal-50 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-teal-500/40 dark:hover:bg-teal-500/10">
                    <span class="inline-flex items-center gap-2">
                        <i class="ph ph-file-code text-base text-zinc-400" aria-hidden="true"></i>
                        {{ trans('hotspot.users.script') }}
                    </span>
                    <i class="ph ph-arrow-square-out text-base text-zinc-400" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<div class="mt-6 rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
    <form method="get" action="{{ url_for('hotspot.users') }}" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-12 lg:items-end">
        <div class="sm:col-span-2 lg:col-span-3">
            <label for="filter-q" class="mb-1.5 block text-xs font-medium text-zinc-600 dark:text-zinc-400">{{ trans('hotspot.users.filter_search') }}</label>
            <div class="relative">
                <i class="ph ph-magnifying-glass pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 text-base text-zinc-400" aria-hidden="true"></i>
                <input type="search" id="filter-q" name="q" value="{{ filters.q|default('') }}" placeholder="{{ trans('hotspot.users.filter_search_ph') }}"
                    class="block w-full rounded-lg border border-zinc-300 bg-white py-2 pe-3 ps-9 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
            </div>
        </div>
        <div class="lg:col-span-2">
            <label for="filter-profile" class="mb-1.5 block text-xs font-medium text-zinc-600 dark:text-zinc-400">{{ trans('hotspot.users.filter_profile') }}</label>
            <select id="filter-profile" name="profile"
                class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                <option value="" {% if profileFilter == '' %}selected{% endif %}>{{ trans('hotspot.users.all_profiles') }}</option>
                {% for p in profiles %}
                <option value="{{ p }}" {% if profileFilter == p %}selected{% endif %}>{{ p }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="lg:col-span-3">
            <label for="filter-comment" class="mb-1.5 block text-xs font-medium text-zinc-600 dark:text-zinc-400">{{ trans('hotspot.users.filter_comment') }}</label>
            <select id="filter-comment" name="comment"
                class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                <option value="" {% if filters.comment|default('') == '' %}selected{% endif %}>{{ trans('hotspot.users.all_comments') }}</option>
                {% for c in comments %}
                <option value="{{ c.comment }}" {% if filters.comment|default('') == c.comment %}selected{% endif %}>{{ c.comment }} [{{ c.count }}]</option>
                {% endfor %}
            </select>
        </div>
        <div class="lg:col-span-2">
            <label for="filter-status" class="mb-1.5 block text-xs font-medium text-zinc-600 dark:text-zinc-400">{{ trans('hotspot.users.filter_status') }}</label>
            <select id="filter-status" name="status"
                class="block w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                <option value="all" {% if filters.status|default('all') == 'all' %}selected{% endif %}>{{ trans('hotspot.users.status_all') }}</option>
                <option value="enabled" {% if filters.status|default('all') == 'enabled' %}selected{% endif %}>{{ trans('hotspot.status_enabled') }}</option>
                <option value="disabled" {% if filters.status|default('all') == 'disabled' %}selected{% endif %}>{{ trans('hotspot.status_disabled') }}</option>
            </select>
        </div>
        <div class="flex flex-wrap items-center gap-2 sm:col-span-2 lg:col-span-2 lg:justify-end">
            <button type="submit"
                class="inline-flex h-9 flex-1 items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-3.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700 sm:flex-none">
                <i class="ph ph-funnel text-base" aria-hidden="true"></i>
                {{ trans('hotspot.users.filter_btn') }}
            </button>
            <a href="{{ url_for('hotspot.users') }}"
                class="inline-flex h-9 flex-1 items-center justify-center rounded-lg border border-zinc-200 bg-white px-3.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600 sm:flex-none">
                {{ trans('hotspot.users.reset') }}
            </a>
        </div>
    </form>
    {% if hasFilters %}
    <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">
        {{ trans('hotspot.users.filter_result', {count: users|length}) }}
    </p>
    {% endif %}
</div>

{% if not hotspotAvailable %}
<div class="mt-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
    <i class="ph ph-info mt-0.5 flex-none text-xl" aria-hidden="true"></i>
    <div>
        <p class="text-sm font-semibold">{{ trans('hotspot.unavailable_title') }}</p>
        <p class="mt-0.5 text-sm">{{ trans('hotspot.users.unavailable_body') }}</p>
    </div>
</div>
{% endif %}

{% if users is empty %}
<div class="mt-8 flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-800">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-700/50">
        <i class="ph ph-user text-2xl text-zinc-400" aria-hidden="true"></i>
    </div>
    <h2 class="mt-4 text-base font-semibold">{{ trans('hotspot.users.empty_title') }}</h2>
    <p class="mt-1 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">
        {% if hasFilters %}
            {{ trans('hotspot.users.empty_filter_text') }}
            <a href="{{ url_for('hotspot.users') }}" class="font-medium text-teal-600 hover:underline dark:text-teal-400">{{ trans('hotspot.users.clear_filters') }}</a>
        {% else %}
            {{ trans('hotspot.users.empty_text') }}
        {% endif %}
    </p>
</div>
{% else %}
{% set allIds = users|map(u => u.id)|json_encode %}
{% set neverIds = users|filter(u => u.neverConnected)|map(u => u.id)|json_encode %}
<div x-data="{
    printModal: false, printUserId: null, printUserName: '',
    printManyModal: false, deleteManyModal: false, resetManyModal: false,
    deleteUserId: null, deleteUserName: '', deleteUserModal: false,
    resetUserId: null, resetUserName: '', resetUserModal: false,
    detailModal: false, detailUser: null, detailLoading: false, showPassword: false,
    selected: [],
    allIds: {{ allIds|default('[]') }},
    neverIds: {{ neverIds|default('[]') }},
    includeActive: false,
    get allSelected() { return this.allIds.length > 0 && this.selected.length === this.allIds.length },
    get someSelected() { return this.selected.length > 0 && !this.allSelected },
    get connectedSelected() { return this.selected.filter(id => !this.neverIds.includes(id)).length },
    toggleAll() { this.selected = this.allSelected ? [] : [...this.allIds] },
    toggle(id) { this.selected = this.selected.includes(id) ? this.selected.filter(i => i !== id) : [...this.selected, id] },
    isSelected(id) { return this.selected.includes(id) },
    openDetail(id) {
        this.detailUser = null;
        this.detailLoading = true;
        this.detailModal = true;
        this.showPassword = false;
        fetch('{{ url_for("hotspot.users.data", {id: "__ID__"}) }}'.replace('__ID__', id))
            .then(r => { if (!r.ok) throw new Error(); return r.json(); })
            .then(data => { this.detailUser = data; this.detailLoading = false; })
            .catch(() => { this.detailLoading = false; this.detailModal = false; });
    }
}">
<!-- Hidden batch forms -->
<form x-ref="deleteManyForm" method="post" action="{{ url_for('hotspot.users.deleteSelected') }}" class="hidden">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="include_active" :value="includeActive ? '1' : ''">
    <template x-for="id in selected" :key="id">
        <input type="hidden" name="user_ids[]" :value="id">
    </template>
</form>
<form x-ref="resetManyForm" method="post" action="{{ url_for('hotspot.users.resetCounters') }}" class="hidden">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <template x-for="id in selected" :key="id">
        <input type="hidden" name="user_ids[]" :value="id">
    </template>
</form>
<form x-ref="deleteUserForm" method="post" class="hidden"
    :action="`{{ url_for('hotspot.users.delete', {id: '__ID__'}) }}`.replace('__ID__', deleteUserId)">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% if profileFilter %}<input type="hidden" name="profile" value="{{ profileFilter }}">{% endif %}
</form>
<form x-ref="resetUserForm" method="post" class="hidden"
    :action="`{{ url_for('hotspot.users.resetCounter', {id: '__ID__'}) }}`.replace('__ID__', resetUserId)">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% if profileFilter %}<input type="hidden" name="profile" value="{{ profileFilter }}">{% endif %}
</form>

<!-- Mobile: stacked cards -->
<div class="mt-6 grid grid-cols-1 gap-3 md:hidden">
    {% for user in users %}
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-3">
            <input type="checkbox" :checked="isSelected('{{ user.id }}')" @change="toggle('{{ user.id }}')"
                class="h-4 w-4 flex-none rounded border-zinc-300 text-teal-600 focus:ring-teal-500 dark:border-zinc-600 dark:bg-zinc-800">
            <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                <i class="ph ph-user text-xl" aria-hidden="true"></i>
            </div>
            <div class="min-w-0 flex-1">
                <p class="truncate font-semibold">{{ user.name }}</p>
                <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">{{ user.profile ?: '—' }}</p>
            </div>
            {% if user.expired and not user.disabled %}
            <span class="inline-flex flex-none items-center rounded-md bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/15 dark:text-red-300">{{ trans('hotspot.users.expired') }}</span>
            {% elseif user.disabled %}
            <span class="inline-flex flex-none items-center rounded-md bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300">{{ trans('hotspot.status_disabled') }}</span>
            {% else %}
            <span class="inline-flex flex-none items-center rounded-md bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ trans('hotspot.status_enabled') }}</span>
            {% endif %}
        </div>
        <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 text-sm">
            {% if user.comment %}
            <div class="flex items-start justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.col_comment') }}</dt>
                <dd class="min-w-0 break-words text-xs text-zinc-600 dark:text-zinc-400">{{ user.comment }}</dd>
            </div>
            {% endif %}
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.col_uptime') }}</dt>
                <dd class="font-mono text-xs tabular-nums text-zinc-600 dark:text-zinc-400">{{ user.uptime ?: '—' }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.col_expires') }}</dt>
                <dd class="font-mono text-xs tabular-nums text-zinc-600 dark:text-zinc-400">{{ user.expires_at ?: '—' }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.col_bytes_in') }}</dt>
                <dd class="font-mono text-xs tabular-nums text-zinc-600 dark:text-zinc-400">{{ user.bytes_in }}</dd>
            </div>
            <div class="flex items-center justify-between gap-4">
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.users.col_bytes_out') }}</dt>
                <dd class="font-mono text-xs tabular-nums text-zinc-600 dark:text-zinc-400">{{ user.bytes_out }}</dd>
            </div>
        </dl>
        <div class="mt-4 flex items-center gap-2">
            <button type="button" title="{{ trans('hotspot.detail') }}" @click="openDetail('{{ user.id|e('js') }}')"
                class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="ph ph-eye text-xl" aria-hidden="true"></i>
            </button>
            <a href="{{ url_for('hotspot.users.edit', {id: user.id}) }}" title="{{ trans('hotspot.edit') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="ph ph-pencil-simple text-xl" aria-hidden="true"></i>
            </a>
            <button type="button" title="{{ trans('hotspot.print') }}" @click="printUserId = '{{ user.id }}'; printUserName = '{{ user.name }}'; printModal = true"
                class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="ph ph-printer text-xl" aria-hidden="true"></i>
            </button>
            <button type="button" title="{{ trans('hotspot.users.reset_counters') }}" @click="resetUserId = '{{ user.id|e('js') }}'; resetUserName = '{{ user.name|e('js') }}'; resetUserModal = true"
                class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="ph ph-arrow-counter-clockwise text-xl" aria-hidden="true"></i>
            </button>
            <button type="button" title="{{ trans('hotspot.remove') }}" @click="deleteUserId = '{{ user.id|e('js') }}'; deleteUserName = '{{ user.name|e('js') }}'; deleteUserModal = true"
                class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                <i class="ph ph-trash text-xl" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Desktop: table -->
<div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block">
    <div class="overflow-x-auto">
        <table class="min-w-full align-middle text-sm">
            <thead>
                <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                    <th class="w-10 px-4 py-3">
                        <input type="checkbox" :checked="allSelected" :indeterminate.prop="someSelected" @change="toggleAll()"
                            class="h-4 w-4 rounded border-zinc-300 text-teal-600 focus:ring-teal-500 dark:border-zinc-600 dark:bg-zinc-800" title="{{ trans('hotspot.users.select_all') }}">
                    </th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_name') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_profile') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_comment') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_uptime') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_bytes_in') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_bytes_out') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_expires') }}</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_status') }}</th>
                    <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.users.th_actions') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                    <td class="w-10 px-4 py-3">
                        <input type="checkbox" :checked="isSelected('{{ user.id }}')" @change="toggle('{{ user.id }}')"
                            class="h-4 w-4 rounded border-zinc-300 text-teal-600 focus:ring-teal-500 dark:border-zinc-600 dark:bg-zinc-800">
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-teal-50 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ user.name|first|upper }}</span>
                            <span class="font-medium">{{ user.name }}</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400">{{ user.profile ?: '—' }}</td>
