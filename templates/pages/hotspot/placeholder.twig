{% extends "layout.twig" %}

{% block title %}{{ title }} - Hotspot - Janathan{% endblock %}

{% block content %}
<div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-800">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
        <i class="ph ph-info text-2xl" aria-hidden="true"></i>
    </div>
    <h1 class="mt-4 text-lg font-bold">{{ title }}</h1>
    <p class="mt-2 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">
        {{ trans('hotspot.placeholder.text') }}
    </p>
</div>
{% endblock %}
