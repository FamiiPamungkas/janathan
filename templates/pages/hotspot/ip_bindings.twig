{% extends "layout.twig" %}

{% block title %}{{ trans('hotspot.ip_bindings.title') }}{% endblock %}

{% block content %}
<div x-data="bindingsPoller()" x-init="init()" class="flex flex-col gap-4">
    <input type="hidden" x-ref="csrf" value="{{ csrf_token }}">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">{{ trans('hotspot.ip_bindings.heading') }}</h1>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="inline-flex items-center gap-1.5">
                    <span class="relative flex size-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75" x-show="!error"></span>
                        <span class="relative inline-flex size-2 rounded-full" :class="error ? 'bg-red-500' : 'bg-teal-500'"></span>
                    </span>
                    {{ router.name }}
                </span>
                <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
                <span class="font-mono">{{ router.host }}:{{ router.port }}</span>
            </p>
        </div>
        <div class="flex w-fit items-center gap-2">
            <span class="hidden text-xs text-zinc-500 dark:text-zinc-400 sm:inline" x-show="updatedAt" x-text="lastUpdatedLabel"></span>
            <a href="{{ url_for('hotspot.ip_bindings.create') }}"
                class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-3.5 text-sm font-medium text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30">
                <i class="ph ph-plus text-base" aria-hidden="true"></i>
                {{ trans('hotspot.ip_bindings.add') }}
            </a>
            <button type="button" @click="refresh()"
                class="inline-flex h-9 items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 disabled:opacity-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600"
                :disabled="loading" :class="loading ? 'opacity-60' : ''">
                <i class="ph ph-arrows-clockwise text-base" :class="loading ? 'animate-spin' : ''" aria-hidden="true"></i>
                {{ trans('hotspot.ip_bindings.refresh') }}
            </button>
        </div>
    </div>

    <div x-show="error" x-cloak class="mt-2 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300">
        <i class="ph ph-warning-circle mt-0.5 flex-none text-xl" aria-hidden="true"></i>
        <p class="text-sm" x-text="error"></p>
    </div>

    {% if not hotspotAvailable %}
    <div class="mt-2 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
        <i class="ph ph-info mt-0.5 flex-none text-xl" aria-hidden="true"></i>
        <div>
            <p class="text-sm font-semibold">{{ trans('hotspot.unavailable_title') }}</p>
            <p class="mt-0.5 text-sm">{{ trans('hotspot.ip_bindings.unavailable_body') }}</p>
        </div>
    </div>
    {% endif %}

    <!-- Empty state -->
    <div x-show="!error && bindings.length === 0" x-cloak class="mt-6 flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-700/50">
            <i class="ph ph-link-simple text-2xl text-zinc-400" aria-hidden="true"></i>
        </div>
        <h2 class="mt-4 text-base font-semibold">{{ trans('hotspot.ip_bindings.empty_title') }}</h2>
        <p class="mt-1 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.ip_bindings.empty_text') }}</p>
    </div>

    <!-- Mobile: stacked cards -->
    <div class="mt-6 grid grid-cols-1 gap-3 md:hidden" x-show="bindings.length > 0" x-cloak>
        <template x-for="b in bindings" :key="b.id">
            <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                        <i class="ph ph-link-simple text-xl" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="truncate font-semibold font-mono text-xs" x-text="b.mac || '—'"></p>
                        <p class="truncate text-xs text-zinc-500 dark:text-zinc-400" x-text="b.address || '—'"></p>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <template x-if="b.type === 'bypassed'">
                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">{{ trans('hotspot.ip_bindings.bypassed') }}</span>
                        </template>
                        <template x-if="b.type === 'blocked'">
                            <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/10 dark:text-red-300">{{ trans('hotspot.ip_bindings.blocked') }}</span>
                        </template>
                        <template x-if="b.type === 'regular'">
                            <span class="inline-flex items-center rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ trans('hotspot.ip_bindings.regular') }}</span>
                        </template>
                    </div>
                    <a :href="'{{ url_for('hotspot.ip_bindings.edit', {id: '__ID__'})|e('js') }}'.replace('__ID__', encodeURIComponent(b.id))"
                        title="{{ trans('hotspot.edit') }}"
                        class="flex h-8 w-8 flex-none items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                        <i class="ph ph-pencil-simple text-xl" aria-hidden="true"></i>
                    </a>
                    <form method="post"
                      x-data="{ bid: b.id, bname: (b.mac || b.address) }"
                      :action="'{{ url_for('hotspot.ip_bindings.remove', {id: '__ID__'})|e('js') }}'.replace('__ID__', encodeURIComponent(bid))"
                      @submit="if (!window.confirm('{{ trans('hotspot.ip_bindings.remove_confirm')|e('js') }}'.replace('{name}', bname))) $event.preventDefault()">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" title="{{ trans('hotspot.remove') }}"
                            class="flex h-8 w-8 flex-none items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                            <i class="ph ph-x-circle text-xl" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
                <dl class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2 text-sm">
                    <template x-if="b.address">
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.ip_bindings.col_address') }}</dt>
                            <dd class="truncate font-mono text-xs text-zinc-600 dark:text-zinc-400" x-text="b.address"></dd>
                        </div>
                    </template>
                    <template x-if="b.mac">
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.ip_bindings.col_mac') }}</dt>
                            <dd class="truncate font-mono text-xs text-zinc-600 dark:text-zinc-400" x-text="b.mac"></dd>
                        </div>
                    </template>
                    <template x-if="b.comment">
                        <div class="flex items-center justify-between gap-4">
                            <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.ip_bindings.col_comment') }}</dt>
                            <dd class="truncate text-xs text-zinc-600 dark:text-zinc-400" x-text="b.comment"></dd>
                        </div>
                    </template>
                    <div class="flex items-center justify-between gap-4">
                        <dt class="text-xs text-zinc-500 dark:text-zinc-400">{{ trans('hotspot.ip_bindings.col_status') }}</dt>
                        <dd class="font-mono text-xs tabular-nums text-zinc-600 dark:text-zinc-400" x-text="b.disabled ? '{{ trans('hotspot.disabled') }}' : '{{ trans('hotspot.status_enabled') }}'"></dd>
                    </div>
                </dl>
            </div>
        </template>
    </div>

    <!-- Desktop: table -->
    <div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block" x-show="bindings.length > 0" x-cloak>
        <div class="overflow-x-auto">
            <table class="min-w-full align-middle text-sm">
                <thead>
                    <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_mac') }}</th>
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_address') }}</th>
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_type') }}</th>
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_comment') }}</th>
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_status') }}</th>
                        <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('hotspot.ip_bindings.th_actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="b in bindings" :key="b.id">
                        <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-2.5">
                                    <span class="font-mono text-xs" x-text="b.mac || '—'"></span>
                                </div>
                            </td>
                            <td class="px-4 py-3 font-mono text-xs text-zinc-600 dark:text-zinc-400" x-text="b.address || '—'"></td>
                            <td class="px-4 py-3">
                                <template x-if="b.type === 'bypassed'">
                                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">{{ trans('hotspot.ip_bindings.bypassed') }}</span>
                                </template>
                                <template x-if="b.type === 'blocked'">
                                    <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 dark:bg-red-500/10 dark:text-red-300">{{ trans('hotspot.ip_bindings.blocked') }}</span>
                                </template>
                                <template x-if="b.type === 'regular'">
                                    <span class="inline-flex items-center rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ trans('hotspot.ip_bindings.regular') }}</span>
                                </template>
                            </td>
                            <td class="max-w-[12rem] truncate px-4 py-3 text-zinc-600 dark:text-zinc-400" x-text="b.comment || '—'"></td>
                            <td class="px-4 py-3">
                                <template x-if="b.disabled">
                                    <span class="inline-flex items-center rounded-full bg-zinc-50 px-2 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-700/50 dark:text-zinc-300">{{ trans('hotspot.disabled') }}</span>
                                </template>
                                <template x-if="!b.disabled">
                                    <span class="inline-flex items-center rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ trans('hotspot.status_enabled') }}</span>
                                </template>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a :href="'{{ url_for('hotspot.ip_bindings.edit', {id: '__ID__'})|e('js') }}'.replace('__ID__', encodeURIComponent(b.id))"
                                        title="{{ trans('hotspot.edit') }}"
                                        class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                        <i class="ph ph-pencil-simple text-xl" aria-hidden="true"></i>
                                    </a>
                                    <form method="post"
                                        x-data="{ bid: b.id, bname: (b.mac || b.address) }"
                                        :action="'{{ url_for('hotspot.ip_bindings.remove', {id: '__ID__'})|e('js') }}'.replace('__ID__', encodeURIComponent(bid))"
                                        @submit="if (!window.confirm('{{ trans('hotspot.ip_bindings.remove_confirm')|e('js') }}'.replace('{name}', bname))) $event.preventDefault()">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <button type="submit" title="{{ trans('hotspot.remove') }}"
                                            class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                                            <i class="ph ph-x-circle text-xl" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    function bindingsPoller() {
        return {
            bindings: [],
            error: '',
            updatedAt: '',
            loading: false,
            interval: 5000,
            timer: null,
            init() {
                this.refresh();
                this.timer = setInterval(() => this.refresh(), this.interval);
            },
            get lastUpdatedLabel() {
                if (!this.updatedAt) return '';
                try {
                    return new Date(this.updatedAt).toLocaleTimeString();
                } catch (e) {
                    return '';
                }
            },
            async refresh() {
                this.loading = true;
                try {
                    const res = await fetch('{{ url_for('hotspot.ip_bindings.data')|e('js') }}');
                    const data = await res.json();
                    if (data.error) {
                        this.error = data.error;
                    } else {
                        this.error = '';
                        this.bindings = data.bindings || [];
                    }
                    this.updatedAt = data.updatedAt || '';
                } catch (e) {
                    this.error = e.message || '{{ trans('hotspot.ip_bindings.flash.reach_error')|e('js') }}';
                } finally {
                    this.loading = false;
                }
            }
        };
    }
</script>
{% endblock %}