{% extends "layout.twig" %}

{% block title %}Dashboard - Janathan{% endblock %}

{% block content %}
<!-- Page header -->
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Dashboard</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            <span class="inline-flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-teal-500"></span>
                </span>
                {{ router.name }}
            </span>
            <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
            <span class="font-mono">{{ router.host }}:{{ router.port }}</span>
        </p>
    </div>
    <a href="{{ url_for('routers.index') }}" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M14 6a4 4 0 0 1 4 4v5.25A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25V10a4 4 0 0 1 4-4h8Zm-1.25 5.75a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75Zm-5.5 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
        </svg>
        Manage routers
    </a>
</div>

<!-- Hotspot unavailable notice -->
{% if not hotspotAvailable %}
<div class="mt-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-5 flex-none">
        <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
    </svg>
    <div>
        <p class="text-sm font-semibold">Hotspot is not available on this router</p>
        <p class="mt-0.5 text-sm">Session and user stats are hidden. Check that the hotspot package is installed and configured, and that the API user has permission to read it.</p>
    </div>
</div>
{% endif %}

<!-- Stat cards -->
<div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path d="M7 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM14.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM1.615 16.428a1.224 1.224 0 0 1-.569-1.175 6.002 6.002 0 0 1 11.908 0c.058.467-.172.92-.57 1.174A9.953 9.953 0 0 1 7 18a9.953 9.953 0 0 1-5.385-1.572ZM14.5 16h-.106c.07-.297.088-.611.048-.933a7.47 7.47 0 0 0-1.588-3.755 4.502 4.502 0 0 1 5.874 2.636.818.818 0 0 1-.36.98A7.465 7.465 0 0 1 14.5 16Z" />
                </svg>
            </div>
            <span class="text-sm font-medium">Active Sessions</span>
        </div>
        <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl">{{ stats.activeSessions }}</p>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">currently online</p>
    </div>

    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600 dark:bg-sky-500/10 dark:text-sky-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5.25a.75.75 0 0 0 .402.66l3.5 2a.75.75 0 0 0 .746-1.302L10.75 9.99V5Z" clip-rule="evenodd" />
                </svg>
            </div>
            <span class="text-sm font-medium">Total Users</span>
        </div>
        <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl">{{ stats.totalUsers }}</p>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">registered accounts</p>
    </div>

    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-500/10 dark:text-violet-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path d="M10 2a6 6 0 0 0-6 6v3.586l-.707.707A1 1 0 0 0 3.586 15H16.414a1 1 0 0 0 .707-1.707L16 11.586V8a6 6 0 0 0-6-6ZM7 15v1a3 3 0 0 0 6 0v-1h-6Z" />
                </svg>
            </div>
            <span class="text-sm font-medium">Traffic</span>
        </div>
        <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl">{{ stats.traffic }}</p>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">active sessions now</p>
    </div>

    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path fill-rule="evenodd" d="M15.5 2A1.5 1.5 0 0 0 14 3.5v13a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5v-13A1.5 1.5 0 0 0 16.5 2h-1ZM9.5 6A1.5 1.5 0 0 0 8 7.5v9A1.5 1.5 0 0 0 9.5 18h1a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 10.5 6h-1ZM3.5 10A1.5 1.5 0 0 0 2 11.5v5A1.5 1.5 0 0 0 3.5 18h1A1.5 1.5 0 0 0 6 16.5v-5A1.5 1.5 0 0 0 4.5 10h-1Z" clip-rule="evenodd" />
                </svg>
            </div>
            <span class="text-sm font-medium">CPU Load</span>
        </div>
        <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl">{{ stats.cpu }}%</p>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">router processor</p>
    </div>
</div>

<!-- System resources + active sessions -->
<div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
    <!-- Router resources -->
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800 lg:col-span-1">
        <h2 class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-zinc-50">
            <span class="relative flex size-2.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                <span class="relative inline-flex size-2.5 rounded-full bg-teal-500"></span>
            </span>
            Router
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4">
                <dt class="text-zinc-500 dark:text-zinc-400">Identity</dt>
                <dd class="truncate font-medium">{{ router.identity }}</dd>
            </div>
            <div class="flex justify-between gap-4">
                <dt class="text-zinc-500 dark:text-zinc-400">Model</dt>
                <dd class="truncate font-medium">{{ router.model }}</dd>
            </div>
            <div class="flex justify-between gap-4">
                <dt class="text-zinc-500 dark:text-zinc-400">Version</dt>
                <dd class="truncate font-medium">{{ router.version }}</dd>
            </div>
            <div class="flex justify-between gap-4">
                <dt class="text-zinc-500 dark:text-zinc-400">Uptime</dt>
                <dd class="truncate font-medium">{{ router.uptime }}</dd>
            </div>
        </dl>

        <div class="mt-6 space-y-5">
            <div>
                <div class="mb-1.5 flex items-center justify-between text-sm">
                    <span class="font-medium">CPU</span>
                    <span class="text-zinc-500 dark:text-zinc-400">{{ router.cpu }}%</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                    <div class="h-full rounded-full bg-teal-500" style="width: {{ router.cpu }}%"></div>
                </div>
            </div>
            <div>
                <div class="mb-1.5 flex items-center justify-between text-sm">
                    <span class="font-medium">Memory</span>
                    <span class="text-zinc-500 dark:text-zinc-400">{{ router.memory }}% · {{ router.freeMemory }} free / {{ router.totalMemory }}</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                    <div class="h-full rounded-full bg-sky-500" style="width: {{ router.memory }}%"></div>
                </div>
            </div>
            <div>
                <div class="mb-1.5 flex items-center justify-between text-sm">
                    <span class="font-medium">Storage</span>
                    <span class="text-zinc-500 dark:text-zinc-400">{{ router.hdd }}% · {{ router.freeHdd }} free / {{ router.totalHdd }}</span>
                </div>
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                    <div class="h-full rounded-full bg-amber-500" style="width: {{ router.hdd }}%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active sessions -->
    <div class="lg:col-span-2"
        x-data="{
            sessions: {{ sessions|json_encode|raw }},
            sortColumn: null,
            sortDirection: 'asc',
            sortedData: [],
            init() {
                this.sortedData = this.sessions;
            },
            sortBy(column) {
                if (this.sortColumn === column) {
                    this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
                } else {
                    this.sortDirection = 'asc';
                    this.sortColumn = column;
                }
                this.sortedData = [...this.sessions].sort((a, b) => {
                    if (a[column] < b[column]) return this.sortDirection === 'asc' ? -1 : 1;
                    if (a[column] > b[column]) return this.sortDirection === 'asc' ? 1 : -1;
                    return 0;
                });
            }
        }">
        <div class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center justify-between border-b border-zinc-100 px-4 py-3 dark:border-zinc-700/50">
                <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">Active Sessions</h2>
                <span class="text-xs text-zinc-500 dark:text-zinc-400" x-text="sortedData.length + ' online'"></span>
            </div>

            <!-- Mobile: stacked session cards -->
            <div class="divide-y divide-zinc-100 md:hidden dark:divide-zinc-700/50">
                <template x-for="s in sortedData" :key="s.id">
                    <div class="p-4">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-teal-50 text-sm font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">
                                <span x-text="s.user.charAt(0).toUpperCase()"></span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-semibold" x-text="s.user"></p>
                                <p class="truncate text-xs text-zinc-500 dark:text-zinc-400" x-text="s.ip + ' · ' + s.mac"></p>
                            </div>
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                                <span class="size-1.5 rounded-full bg-teal-500"></span>
                                <span x-text="s.status"></span>
                            </span>
                        </div>
                        <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Uptime</dt>
                                <dd class="font-medium" x-text="s.uptime"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Download</dt>
                                <dd class="font-medium text-teal-600 dark:text-teal-400" x-text="s.download"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Upload</dt>
                                <dd class="font-medium" x-text="s.upload"></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Server</dt>
                                <dd class="font-medium" x-text="s.server"></dd>
                            </div>
                        </dl>
                    </div>
                </template>
            </div>

            <!-- Desktop: sortable table -->
            <div class="hidden overflow-x-auto md:block">
                <table class="min-w-full align-middle text-sm whitespace-nowrap">
                    <thead>
                        <tr class="border-b border-zinc-100 dark:border-zinc-700/50">
                            <th class="group px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">
                                <div class="inline-flex items-center gap-2">
                                    <span>User</span>
                                    <button type="button" @click="sortBy('user')" class="inline-flex items-center justify-center rounded-lg border border-zinc-200 bg-white px-1.5 py-1 text-sm leading-5 font-semibold text-zinc-800 transition hover:border-zinc-300 hover:text-zinc-900 hover:shadow-xs focus:ring-3 focus:ring-zinc-300/25 active:border-zinc-200 active:shadow-none dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:text-zinc-200 dark:focus:ring-zinc-600/40" x-bind:class="{ 'opacity-25 group-hover:opacity-100': sortColumn !== 'user' }">
                                        <template x-if="sortColumn !== 'user'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M13.78 10.47a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l.97.97V5.75a.75.75 0 0 1 1.5 0v5.69l.97-.97a.75.75 0 0 1 1.06 0ZM2.22 5.53a.75.75 0 0 1 0-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1-1.06 1.06l-.97-.97v5.69a.75.75 0 0 1-1.5 0V4.56l-.97.97a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'user' && sortDirection === 'desc'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8 2a.75.75 0 0 1 .75.75v8.69l1.22-1.22a.75.75 0 1 1 1.06 1.06l-2.5 2.5a.75.75 0 0 1-1.06 0l-2.5-2.5a.75.75 0 1 1 1.06-1.06l1.22 1.22V2.75A.75.75 0 0 1 8 2Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'user' && sortDirection === 'asc'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8 14a.75.75 0 0 0 .75-.75V4.56l1.22 1.22a.75.75 0 1 0 1.06-1.06l-2.5-2.5a.75.75 0 0 0-1.06 0l-2.5 2.5a.75.75 0 0 0 1.06 1.06l1.22-1.22v8.69c0 .414.336.75.75.75Z" clip-rule="evenodd" /></svg>
                                        </template>
                                    </button>
                                </div>
                            </th>
                            <th class="group px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">
                                <div class="inline-flex items-center gap-2">
                                    <span>IP Address</span>
                                    <button type="button" @click="sortBy('ip')" class="inline-flex items-center justify-center rounded-lg border border-zinc-200 bg-white px-1.5 py-1 text-sm leading-5 font-semibold text-zinc-800 transition hover:border-zinc-300 hover:text-zinc-900 hover:shadow-xs focus:ring-3 focus:ring-zinc-300/25 active:border-zinc-200 active:shadow-none dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:text-zinc-200 dark:focus:ring-zinc-600/40" x-bind:class="{ 'opacity-25 group-hover:opacity-100': sortColumn !== 'ip' }">
                                        <template x-if="sortColumn !== 'ip'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M13.78 10.47a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l.97.97V5.75a.75.75 0 0 1 1.5 0v5.69l.97-.97a.75.75 0 0 1 1.06 0ZM2.22 5.53a.75.75 0 0 1 0-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1-1.06 1.06l-.97-.97v5.69a.75.75 0 0 1-1.5 0V4.56l-.97.97a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'ip' && sortDirection === 'desc'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8 2a.75.75 0 0 1 .75.75v8.69l1.22-1.22a.75.75 0 1 1 1.06 1.06l-2.5 2.5a.75.75 0 0 1-1.06 0l-2.5-2.5a.75.75 0 1 1 1.06-1.06l1.22 1.22V2.75A.75.75 0 0 1 8 2Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'ip' && sortDirection === 'asc'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8 14a.75.75 0 0 0 .75-.75V4.56l1.22 1.22a.75.75 0 1 0 1.06-1.06l-2.5-2.5a.75.75 0 0 0-1.06 0l-2.5 2.5a.75.75 0 0 0 1.06 1.06l1.22-1.22v8.69c0 .414.336.75.75.75Z" clip-rule="evenodd" /></svg>
                                        </template>
                                    </button>
                                </div>
                            </th>
                            <th class="px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">
                                <span>MAC</span>
                            </th>
                            <th class="group px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">
                                <div class="inline-flex items-center gap-2">
                                    <span>Uptime</span>
                                    <button type="button" @click="sortBy('uptime')" class="inline-flex items-center justify-center rounded-lg border border-zinc-200 bg-white px-1.5 py-1 text-sm leading-5 font-semibold text-zinc-800 transition hover:border-zinc-300 hover:text-zinc-900 hover:shadow-xs focus:ring-3 focus:ring-zinc-300/25 active:border-zinc-200 active:shadow-none dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600 dark:hover:text-zinc-200 dark:focus:ring-zinc-600/40" x-bind:class="{ 'opacity-25 group-hover:opacity-100': sortColumn !== 'uptime' }">
                                        <template x-if="sortColumn !== 'uptime'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M13.78 10.47a.75.75 0 0 1 0 1.06l-2.25 2.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l.97.97V5.75a.75.75 0 0 1 1.5 0v5.69l.97-.97a.75.75 0 0 1 1.06 0ZM2.22 5.53a.75.75 0 0 1 0-1.06l2.25-2.25a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1-1.06 1.06l-.97-.97v5.69a.75.75 0 0 1-1.5 0V4.56l-.97.97a.75.75 0 0 1-1.06 0Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'uptime' && sortDirection === 'desc'">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8 2a.75.75 0 0 1 .75.75v8.69l1.22-1.22a.75.75 0 1 1 1.06 1.06l-2.5 2.5a.75.75 0 0 1-1.06 0l-2.5-2.5a.75.75 0 1 1 1.06-1.06l1.22 1.22V2.75A.75.75 0 0 1 8 2Z" clip-rule="evenodd" /></svg>
                                        </template>
                                        <template x-if="sortColumn === 'uptime' && sortDirection === 'asc'">
