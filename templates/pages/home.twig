{% extends "layout.twig" %}

{% block title %}{{ trans('title.dashboard') }}{% endblock %}

{% block content %}
<div
    x-data="{
        stats: {{ stats|json_encode|e('html_attr') }},
        logs: {{ logs|json_encode|e('html_attr') }},
        router: {{ router|json_encode|e('html_attr') }},
        hotspotAvailable: {{ hotspotAvailable ? 'true' : 'false' }},
        url: '{{ url_for('dashboard.data')|e('html_attr') }}',
        urlLogs: '{{ url_for('dashboard.logs')|e('html_attr') }}',
        interval: 3000,
        logsInterval: 3000,
        polling: true,
        lastUpdated: null,
        logsUpdatedAt: null,
        error: '',
        refreshing: false,
        logsRefreshing: false,
        timer: null,
        logsTimer: null,
        init() {
            this.start();
        },
        start() {
            this.stop();
            this.polling = true;
            this.timer = setInterval(() => this.refreshStats(), this.interval);
            this.logsTimer = setInterval(() => this.refreshLogs(), this.logsInterval);
        },
        stop() {
            this.polling = false;
            if (this.timer) {
                clearInterval(this.timer);
                this.timer = null;
            }
            if (this.logsTimer) {
                clearInterval(this.logsTimer);
                this.logsTimer = null;
            }
        },
        togglePolling() {
            this.polling ? this.stop() : this.start();
        },
        async refreshStats() {
            if (this.refreshing) {
                return;
            }
            this.refreshing = true;
            try {
                const res = await fetch(this.url);
                const data = await res.json();
                if (!res.ok) {
                    throw new Error(data.error || 'Failed to refresh dashboard data.');
                }
                this.stats = data.stats;
                this.router = data.router;
                this.hotspotAvailable = data.hotspotAvailable;
                this.lastUpdated = new Date();
                this.error = '';
            } catch (e) {
                this.error = e.message || 'Failed to refresh dashboard data.';
            } finally {
                this.refreshing = false;
            }
        },
        async refreshLogs() {
            if (this.logsRefreshing) {
                return;
            }
            this.logsRefreshing = true;
            try {
                const res = await fetch(this.urlLogs);
                const data = await res.json();
                if (!res.ok) {
                    throw new Error(data.error || 'Failed to refresh hotspot logs.');
                }
                if (data.ok && data.logs) {
                    this.logs = this.mergeLogs(this.logs, data.logs);
                    this.logsUpdatedAt = new Date();
                }
            } catch (e) {
                // A transient logs failure must not clear the logs already on screen.
            } finally {
                this.logsRefreshing = false;
            }
        },
        mergeLogs(existing, fresh) {
            if (!fresh || fresh.length === 0) {
                return existing;
            }
            const seen = new Set(existing.map(l => l.id || (l.time + '|' + l.message)));
            const merged = [];
            for (const l of fresh) {
                const key = l.id || (l.time + '|' + l.message);
                if (!seen.has(key)) {
                    seen.add(key);
                    merged.push(l);
                }
            }
            return merged.concat(existing).slice(0, 50);
        },
        timeLabel() {
            return this.lastUpdated ? this.lastUpdated.toLocaleTimeString() : '';
        }
    }">
    <!-- Page header -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center md:items-start sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">{{ trans('menu.dashboard') }}</h1>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                <span class="inline-flex items-center gap-1.5">
                    <span class="relative flex size-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                        <span class="relative inline-flex size-2 rounded-full bg-teal-500"></span>
                    </span>
                    {{ router.name }}
                </span>
                <span class="mx-1.5 text-zinc-300 dark:text-zinc-700">·</span>
                <span class="font-mono">{{ router.host }}:{{ router.port }}</span>
            </p>
        </div>
        <div>
            <div class="flex items-center justify-end grow gap-3">
                <span class="text-xs text-zinc-500 dark:text-zinc-400" x-show="lastUpdated" x-text="'{{ trans('dashboard.updated') }} ' + timeLabel()"></span>
                <button type="button" @click="togglePolling" class="inline-flex w-fit items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <template x-if="polling">
                    <i class="ph ph-pause text-base" aria-hidden="true"></i>
                </template>
                <template x-if="!polling">
                    <i class="ph ph-play text-base" aria-hidden="true"></i>
                </template>
                <span x-text="polling ? '{{ trans('dashboard.pause_refresh') }}' : '{{ trans('dashboard.resume_refresh') }}'"></span>
            </button>
            </div>
        </div>
    </div>

    <!-- Connection error notice -->
    <div x-show="error" x-transition class="mt-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200">
        <i class="ph ph-x-circle mt-0.5 flex-none text-xl text-red-500" aria-hidden="true"></i>
        <div>
            <p class="text-sm font-semibold">{{ trans('dashboard.connection_lost') }}</p>
            <p class="mt-0.5 text-sm" x-text="error"></p>
        </div>
    </div>

    <!-- Hotspot unavailable notice -->
    {% if not hotspotAvailable %}
    <div x-show="!hotspotAvailable" class="mt-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
        <i class="ph ph-info mt-0.5 flex-none text-xl" aria-hidden="true"></i>
        <div>
            <p class="text-sm font-semibold">{{ trans('dashboard.hotspot_unavailable_title') }}</p>
            <p class="mt-0.5 text-sm">{{ trans('dashboard.hotspot_unavailable_body') }}</p>
        </div>
    </div>
    {% endif %}

    <!-- Stat cards -->
    <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                    <i class="ph ph-users-three text-base" aria-hidden="true"></i>
                </div>
                <span class="text-sm font-medium">{{ trans('dashboard.stat.active_sessions') }}</span>
            </div>
            <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl" x-text="stats.activeSessions"></p>
            <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.stat.active_sessions_sub') }}</p>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600 dark:bg-sky-500/10 dark:text-sky-300">
                    <i class="ph ph-identification-card text-base" aria-hidden="true"></i>
                </div>
                <span class="text-sm font-medium">{{ trans('dashboard.stat.total_users') }}</span>
            </div>
            <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl" x-text="stats.totalUsers"></p>
            <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.stat.total_users_sub') }}</p>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-500/10 dark:text-violet-300">
                    <i class="ph ph-chart-bar text-base" aria-hidden="true"></i>
                </div>
                <span class="text-sm font-medium">{{ trans('dashboard.stat.traffic') }}</span>
            </div>
            <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl" x-text="stats.traffic"></p>
            <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.stat.traffic_sub') }}</p>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center gap-2 text-zinc-500 dark:text-zinc-400">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-300">
                    <i class="ph ph-gauge text-base" aria-hidden="true"></i>
                </div>
                <span class="text-sm font-medium">{{ trans('dashboard.stat.cpu') }}</span>
            </div>
            <p class="mt-3 text-2xl font-bold tabular-nums sm:text-3xl" x-text="stats.cpu + '%'"></p>
            <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.stat.cpu_sub') }}</p>
        </div>
    </div>

    <!-- System resources + hotspot logs -->
    <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
        <!-- Router resources -->
        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800 lg:col-span-1">
            <h2 class="flex items-center gap-2 text-sm font-semibold text-zinc-900 dark:text-zinc-50">
                <span class="relative flex size-2.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex size-2.5 rounded-full bg-teal-500"></span>
                </span>
                {{ trans('dashboard.router') }}
            </h2>
            <dl class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_identity') }}</dt>
                    <dd class="truncate font-medium" x-text="router.identity"></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_model') }}</dt>
                    <dd class="truncate font-medium" x-text="router.model"></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_board') }}</dt>
                    <dd class="truncate font-medium" x-text="router.board"></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_version') }}</dt>
                    <dd class="truncate font-medium" x-text="router.version"></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_uptime') }}</dt>
                    <dd class="truncate font-medium" x-text="router.uptime"></dd>
                </div>
                <div class="flex justify-between gap-4">
                    <dt class="text-zinc-500 dark:text-zinc-400">{{ trans('dashboard.router_datetime') }}</dt>
                    <dd class="truncate font-medium" x-text="router.clock.datetime + (router.clock.timezone ? ' · ' + router.clock.timezone : '')"></dd>
                </div>
            </dl>

            <div class="mt-6 space-y-5">
                <div>
                    <div class="mb-1.5 flex items-center justify-between text-sm">
                        <span class="font-medium">{{ trans('dashboard.res_cpu') }}</span>
                        <span class="text-zinc-500 dark:text-zinc-400" x-text="router.cpu + '%'"></span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                        <div class="h-full rounded-full bg-teal-500" x-bind:style="'width: ' + router.cpu + '%'"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1.5 flex items-center justify-between text-sm">
                        <span class="font-medium">{{ trans('dashboard.res_memory') }}</span>
                        <span class="text-zinc-500 dark:text-zinc-400" x-text="router.memory + '% · ' + router.freeMemory + ' free / ' + router.totalMemory"></span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                        <div class="h-full rounded-full bg-sky-500" x-bind:style="'width: ' + router.memory + '%'"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1.5 flex items-center justify-between text-sm">
                        <span class="font-medium">{{ trans('dashboard.res_storage') }}</span>
                        <span class="text-zinc-500 dark:text-zinc-400" x-text="router.hdd + '% · ' + router.freeHdd + ' free / ' + router.totalHdd"></span>
                    </div>
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-700/60">
                        <div class="h-full rounded-full bg-amber-500" x-bind:style="'width: ' + router.hdd + '%'"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hotspot logs -->
        <div class="lg:col-span-2">
            <div class="rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800">
                <div class="flex items-center justify-between border-b border-zinc-100 px-4 py-3 dark:border-zinc-700/50">
                    <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('dashboard.hotspot_logs') }}</h2>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400" x-text="logs.length + ' {{ trans('dashboard.log_entries') }}'"></span>
                </div>

                <!-- Empty state -->
                <div x-show="logs.length === 0" class="p-4 text-sm text-zinc-500 dark:text-zinc-400">
                    {{ trans('dashboard.logs_empty') }}
                </div>

                <!-- Mobile: stacked log entries -->
                <div class="divide-y divide-zinc-100 md:hidden dark:divide-zinc-700/50">
                    <template x-for="l in logs" :key="l.id">
                        <div class="p-4">
                            <div class="flex items-center justify-between gap-3">
                                <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400" x-text="l.time"></span>
                                <span class="inline-flex flex-none items-center rounded-full px-2 py-0.5 text-xs font-medium" x-text="l.user"></span>
                            </div>
                            <p class="mt-2 text-sm whitespace-pre-line break-words text-zinc-700 dark:text-zinc-300" x-text="l.message"></p>
                        </div>
                    </template>
                </div>

                <!-- Desktop: table -->
                <div class="hidden overflow-x-auto md:block">
                    <table class="min-w-full align-middle text-sm">
                        <thead>
                            <tr class="border-b border-zinc-100 dark:border-zinc-700/50">
                                <th class="px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('dashboard.log_time') }}</th>
                                <th class="px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('dashboard.log_user') }}</th>
                                <th class="px-3 py-2 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('dashboard.log_message') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="l in logs" :key="l.id">
                                <tr class="align-top border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                                    <td class="px-3 py-2.5 font-mono text-xs whitespace-nowrap text-zinc-600 dark:text-zinc-400" x-text="l.time"></td>
                                    <td class="px-3 py-2.5 text-zinc-700 whitespace-pre-line break-words dark:text-zinc-300" x-text="l.user"></td>
                                    <td class="px-3 py-2.5 text-zinc-700 whitespace-pre-line break-words dark:text-zinc-300" x-text="l.message"></td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
