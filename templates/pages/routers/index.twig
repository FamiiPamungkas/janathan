{% extends "layout.twig" %}

{% block title %}Routers - Janathan{% endblock %}

{% block content %}
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Routers</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Add MikroTik routers, then connect to one to view its dashboard
        </p>
    </div>
    <a href="{{ url_for('routers.create') }}"
        class="inline-flex w-fit items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
        </svg>
        Add router
    </a>
</div>

{% if routers is empty %}
<div class="mt-8 flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-10 text-center dark:border-zinc-700 dark:bg-zinc-800">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-100 dark:bg-zinc-700/50">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-6 text-zinc-400">
            <path fill-rule="evenodd" d="M2.5 4.25A2.25 2.25 0 0 1 4.75 2h10.5A2.25 2.25 0 0 1 17.5 4.25v11.5A2.25 2.25 0 0 1 15.25 18H4.75a2.25 2.25 0 0 1-2.25-2.25V4.25Zm3.75 3a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 0-1.5h-7.5ZM6 10.25a.75.75 0 0 1 .75-.75h2.5a.75.75 0 0 1 0 1.5h-2.5a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
        </svg>
    </div>
    <h2 class="mt-4 text-base font-semibold">No routers yet</h2>
    <p class="mt-1 max-w-sm text-sm text-zinc-500 dark:text-zinc-400">
        Add your first MikroTik router to connect to it and see live hotspot data.
    </p>
    <a href="{{ url_for('routers.create') }}" class="mt-5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600">
        Add your first router
    </a>
</div>
{% else %}
<!-- Mobile: stacked cards -->
<div class="mt-6 grid grid-cols-1 gap-3 md:hidden">
    {% for router in routers %}
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full
                    {% if active_router and active_router.id == router.id %}bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300{% else %}bg-zinc-100 text-zinc-500 dark:bg-zinc-700/50 dark:text-zinc-400{% endif %}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                        <path fill-rule="evenodd" d="M1 7.25A2.25 2.25 0 0 1 3.25 5h13.5A2.25 2.25 0 0 1 19 7.25v5.5A2.25 2.25 0 0 1 16.75 15H3.25A2.25 2.25 0 0 1 1 12.75v-5.5Zm1.5 0c0-.414.336-.75.75-.75h13.5c.414 0 .75.336.75.75v5.5c0 .414-.336.75-.75.75H3.25a.75.75 0 0 1-.75-.75v-5.5ZM5 9.75a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 5 9.75Z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <p class="flex items-center gap-2 truncate font-semibold">
                        {{ router.name }}
                        {% if active_router and active_router.id == router.id %}
                        <span class="inline-flex items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                            <span class="size-1.5 rounded-full bg-teal-500"></span>Active
                        </span>
                        {% endif %}
                    </p>
                    <p class="truncate font-mono text-xs text-zinc-500 dark:text-zinc-400">{{ router.host }}:{{ router.port }}</p>
                </div>
            </div>
        </div>
        <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <div>
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">User</dt>
                <dd class="font-medium">{{ router.username }}</dd>
            </div>
            <div>
                <dt class="text-xs text-zinc-500 dark:text-zinc-400">Encryption</dt>
                <dd class="font-medium">{{ router.ssl ? 'API-SSL' : 'API' }}</dd>
            </div>
        </dl>
        <div class="mt-4 flex flex-wrap items-center gap-2">
            {% if active_router and active_router.id == router.id %}
            <a href="{{ url_for('home') }}" class="inline-flex items-center gap-1.5 rounded-lg bg-teal-500 px-3 py-1.5 text-sm font-semibold text-white hover:bg-teal-600">Dashboard</a>
            {% else %}
            <form method="post" action="{{ url_for('routers.connect', {id: router.id}) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-teal-500 px-3 py-1.5 text-sm font-semibold text-white hover:bg-teal-600">Connect</button>
            </form>
            {% endif %}
            <a href="{{ url_for('routers.edit', {id: router.id}) }}" class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">Edit</a>
            <form method="post" action="{{ url_for('routers.delete', {id: router.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove router &quot;{{ router.name }}&quot;?')) $event.preventDefault()">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">Remove</button>
            </form>
        </div>
    </div>
    {% endfor %}
</div>

<!-- Desktop: table -->
<div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block">
    <div class="overflow-x-auto">
        <table class="min-w-full align-middle text-sm">
            <thead>
                <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Router</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Address</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">User</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Encryption</th>
                    <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for router in routers %}
                <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-teal-50 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ router.name|first|upper }}</span>
                            <span class="font-medium">{{ router.name }}</span>
                            {% if active_router and active_router.id == router.id %}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                                <span class="size-1.5 rounded-full bg-teal-500"></span>Active
                            </span>
                            {% endif %}
                        </div>
                    </td>
                    <td class="px-4 py-3 font-mono text-xs text-zinc-600 dark:text-zinc-400">{{ router.host }}:{{ router.port }}</td>
                    <td class="px-4 py-3">{{ router.username }}</td>
                    <td class="px-4 py-3">
                        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ router.ssl ? 'API-SSL' : 'API' }}</span>
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center justify-end gap-2">
                            {% if active_router and active_router.id == router.id %}
                            <a href="{{ url_for('home') }}" class="rounded-lg bg-teal-500 px-3 py-1.5 text-sm font-semibold text-white hover:bg-teal-600">Dashboard</a>
                            {% else %}
                            <form method="post" action="{{ url_for('routers.connect', {id: router.id}) }}">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" class="rounded-lg bg-teal-500 px-3 py-1.5 text-sm font-semibold text-white hover:bg-teal-600">Connect</button>
                            </form>
                            {% endif %}
                            <a href="{{ url_for('routers.edit', {id: router.id}) }}" class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">Edit</a>
                            <form method="post" action="{{ url_for('routers.delete', {id: router.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove router &quot;{{ router.name }}&quot;?')) $event.preventDefault()">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" class="rounded-lg border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">Remove</button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}
{% endblock %}
