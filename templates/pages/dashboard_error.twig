{% extends "layout.twig" %}

{% block title %}Router unreachable - Janathan{% endblock %}

{% block content %}
<div class="mx-auto mt-10 w-full max-w-lg">
    <div class="flex flex-col items-center rounded-xl border border-amber-200 bg-amber-50 p-8 text-center dark:border-amber-500/30 dark:bg-amber-500/10">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-6 text-amber-500">
                <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.75 5a.75.75 0 0 1 1.5 0v5.25a.75.75 0 0 1-1.5 0V5ZM10 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
        </div>
        <h1 class="mt-4 text-lg font-bold">Cannot reach router</h1>
        <p class="mt-2 text-sm text-amber-800 dark:text-amber-200">{{ message }}</p>
        <p class="mt-1 text-xs text-amber-700 dark:text-amber-300">
            Check that the router is powered on, reachable from this server, and that the saved credentials are correct.
        </p>
        <div class="mt-6 flex flex-col gap-2 sm:flex-row">
            <a href="{{ url_for('routers.index') }}" class="rounded-lg border border-amber-300 bg-white px-4 py-2 text-sm font-medium text-amber-700 hover:bg-amber-100 dark:border-amber-500/40 dark:bg-transparent dark:text-amber-200 dark:hover:bg-amber-500/10">Manage routers</a>
            <a href="{{ url_for('home') }}" class="rounded-lg bg-amber-500 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-600">Try again</a>
        </div>
    </div>
</div>
{% endblock %}
