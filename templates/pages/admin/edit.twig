{% extends "layout.twig" %}

{% block title %}{{ trans('admin.title') }}{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-2xl">
    <div>
        <a href="{{ url_for('dashboard') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="ph ph-arrow-left text-base" aria-hidden="true"></i>
            {{ trans('admin.back') }}
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ trans('admin.heading') }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">{{ trans('admin.subtitle') }}</p>
    </div>

    <form method="post" action="{{ url_for('admin.update') }}" class="mt-6 space-y-6">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <!-- Account -->
        <section class="rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800"
            x-data="{ show: false }">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('admin.section_account') }}</h2>
            <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('admin.section_account_help') }}</p>

            <div class="mt-4 space-y-5">
                <div>
                    <label for="username" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('admin.username') }}</label>
                    <input type="text" id="username" name="username" required autocomplete="username"
                        value="{{ values.username|default(user.username|default('')) }}"
                        class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.username %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                    {% if errors.username %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.username }}</p>{% endif %}
                </div>

                <div>
                    <label for="password" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('admin.password') }}</label>
                    <div class="relative">
                        <input :type="show ? 'text' : 'password'" id="password" name="password" autocomplete="new-password"
                            class="block w-full rounded-lg border border-zinc-300 px-3 py-2 pr-10 font-mono text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                        <button type="button" @click="show = !show"
                            class="absolute inset-y-0 right-0 flex w-9 items-center justify-center text-zinc-500 transition hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300"
                            :aria-label="show ? 'Hide password' : 'Show password'">
                            <i class="ph" :class="show ? 'ph-eye-slash' : 'ph-eye'" aria-hidden="true"></i>
                        </button>
                    </div>
                    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{{ trans('admin.password_help') }}</p>
                </div>
            </div>
        </section>

        <!-- Preferences -->
        <section class="rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('admin.section_prefs') }}</h2>

            <div class="mt-4">
                <label for="locale" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">{{ trans('admin.language') }}</label>
                <select id="locale" name="locale"
                    class="block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm text-zinc-900 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                    {% set currentLocale = values.locale|default(user.locale|default('en')) %}
                    {% for code, label in locales %}
                        <option value="{{ code }}" {% if code == currentLocale %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
        </section>

        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
            <a href="{{ url_for('dashboard') }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">{{ trans('admin.cancel') }}</a>
            <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                {{ trans('admin.save') }}
            </button>
        </div>
    </form>
</div>
{% endblock %}
