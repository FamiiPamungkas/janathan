{% extends "layout.twig" %}

{% block title %}{{ isEdit ? 'Edit voucher template' : 'Add voucher template' }} - Janathan{% endblock %}

{% block content %}
<div class="mx-auto w-full max-w-3xl">
    <div>
        <a href="{{ url_for('voucher_templates.index') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="lni lni-arrow-left text-base" aria-hidden="true"></i>
            Back to voucher templates
        </a>
        <h1 class="mt-3 text-2xl font-bold tracking-tight">{{ isEdit ? 'Edit voucher template' : 'Add voucher template' }}</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Define the HTML parts of your printable voucher. The row is repeated once per voucher.
        </p>
    </div>

    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-700 dark:bg-zinc-800">
        <form method="post" action="{{ url_for(formAction, formParams) }}" class="space-y-5">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

            <div>
                <label for="name" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Name</label>
                <input type="text" id="name" name="name" required placeholder="e.g. Standard ticket"
                    value="{{ values.name|default(template.name|default('')) }}"
                    class="block w-full rounded-lg border px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:bg-zinc-900 dark:text-zinc-100 {% if errors.name %}border-red-400 dark:border-red-500{% else %}border-zinc-300 dark:border-zinc-600{% endif %}">
                {% if errors.name %}<p class="mt-1 text-xs text-red-600 dark:text-red-400">{{ errors.name }}</p>{% endif %}
            </div>

            <div>
                <label for="header" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Header <span class="font-normal text-zinc-500 dark:text-zinc-400">(HTML top part)</span></label>
                <textarea id="header" name="header" rows="5" spellcheck="false" placeholder="<html>&#10;&#10;<body>&#10;  <h1>WiFi Voucher</h1>"
                    class="block w-full resize-y rounded-lg border border-zinc-300 px-3 py-2 font-mono text-xs leading-relaxed text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">{{ values.header|default(template.header|default('')) }}</textarea>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Rendered once at the top of the voucher page.</p>
            </div>

            <div>
                <label for="row" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Row <span class="font-normal text-zinc-500 dark:text-zinc-400">(per-voucher HTML, looped)</span></label>
                <textarea id="row" name="row" rows="5" spellcheck="false" placeholder="<table>  <tr>    <td>{username}</td>    <td>{password}</td>  </tr></table>"
                    class="block w-full resize-y rounded-lg border border-zinc-300 px-3 py-2 font-mono text-xs leading-relaxed text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">{{ values.row|default(template.row|default('')) }}</textarea>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Repeated once per voucher. Use placeholders like <code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-[11px] dark:bg-zinc-700/50">{username}</code> and <code class="rounded bg-zinc-100 px-1 py-0.5 font-mono text-[11px] dark:bg-zinc-700/50">{password}</code>.</p>
            </div>

            <div>
                <label for="footer" class="mb-1.5 block text-sm font-medium text-zinc-700 dark:text-zinc-300">Footer <span class="font-normal text-zinc-500 dark:text-zinc-400">(HTML bottom part)</span></label>
                <textarea id="footer" name="footer" rows="5" spellcheck="false" placeholder="  <p>Thank you!</p>&#10;</body>&#10;</html>"
                    class="block w-full resize-y rounded-lg border border-zinc-300 px-3 py-2 font-mono text-xs leading-relaxed text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">{{ values.footer|default(template.footer|default('')) }}</textarea>
                <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Rendered once at the bottom of the voucher page.</p>
            </div>

            <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                <a href="{{ url_for('voucher_templates.index') }}" class="rounded-lg border border-zinc-200 bg-white px-4 py-2.5 text-center text-sm font-medium text-zinc-700 hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">Cancel</a>
                <button type="submit" class="rounded-lg bg-teal-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
                    {{ isEdit ? 'Save changes' : 'Add template' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
