{% extends "layout.twig" %}

{% block title %}{{ trans('voucher_templates.title') }}{% endblock %}

{% block content %}
<div
    x-data="{
        shown: false,
        loading: false,
        isDummy: false,
        templateName: '',
        baseUrl: '',
        profiles: [],
        dummyProfiles: [{ name: 'DEMO', color: '#14b8a6', price: '' }],
        open(id, name, url) {
            this.shown = true;
            this.templateName = name;
            this.baseUrl = url;
            this.load();
        },
        async load() {
            this.loading = true;
            this.isDummy = false;
            this.profiles = [];
            try {
                const res = await fetch('{{ url_for('voucher_templates.profiles')|e('js') }}');
                const data = await res.json();
                if (Array.isArray(data) && data.length > 0) {
                    this.profiles = data;
                } else {
                    this.isDummy = true;
                    this.profiles = this.dummyProfiles;
                }
            } catch (e) {
                this.isDummy = true;
                this.profiles = this.dummyProfiles;
            }
            this.loading = false;
        },
        formatPrice(p) {
            if (!p.price) return 'No price';
            return 'Rp ' + Number(p.price).toLocaleString('id-ID');
        },
        printProfile(p) {
            const query = encodeURIComponent(JSON.stringify([{ name: p.name, color: p.color, price: p.price }]));
            window.open(this.baseUrl + '?profiles=' + query, '_blank');
            this.shown = false;
        }
    }"
>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">{{ trans('voucher_templates.heading') }}</h1>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                {{ trans('voucher_templates.subtitle') }}
            </p>
        </div>
        <a href="{{ url_for('voucher_templates.create') }}"
            class="inline-flex w-fit items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
            <i class="ph ph-plus text-base" aria-hidden="true"></i>
            {{ trans('voucher_templates.add') }}
        </a>
    </div>

    {% set has_custom = templates|length > 1 %}

    <!-- Mobile: stacked cards -->
    <div class="mt-6 grid grid-cols-1 gap-3 md:hidden">
        {% for template in templates %}
        <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-start justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full {% if template.is_default %}bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300{% else %}bg-zinc-100 text-zinc-500 dark:bg-zinc-700/50 dark:text-zinc-400{% endif %}">
                        <i class="ph ph-ticket text-xl" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="flex items-center gap-2 truncate font-semibold">
                            {{ template.name }}
                            {% if template.is_default %}
                            <span class="inline-flex flex-none items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                                <span class="size-1.5 rounded-full bg-teal-500"></span>{{ trans('voucher_templates.default') }}
                            </span>
                            {% endif %}
                        </p>
                        {% if template.is_default %}
                        <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">{{ trans('voucher_templates.system_readonly') }}</p>
                        {% else %}
                        <p class="text-xs text-zinc-500 dark:text-zinc-400">
                            {{ template.header is not empty ? trans('voucher_templates.section_header') : '—' }} · {{ template.row is not empty ? trans('voucher_templates.section_row') : '—' }} · {{ template.footer is not empty ? trans('voucher_templates.section_footer') : '—' }}
                        </p>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-2">
                <button type="button" @click="open({{ template.id }}, '{{ template.name|e('js') }}', '{{ url_for('voucher_templates.preview_render', {id: template.id})|e('js') }}')" title="{{ trans('voucher_templates.preview') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                    <i class="ph ph-eye text-xl" aria-hidden="true"></i>
                </button>
                {% if not template.is_default %}
                <a href="{{ url_for('voucher_templates.edit', {id: template.id}) }}" title="{{ trans('hotspot.edit') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                    <i class="ph ph-pencil-simple text-xl" aria-hidden="true"></i>
                </a>
                <form method="post" action="{{ url_for('voucher_templates.delete', {id: template.id}) }}" x-data="{}" @submit="if (!window.confirm('{{ trans('voucher_templates.remove_confirm', {name: template.name})|e('js') }}')) $event.preventDefault()">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <button type="submit" title="{{ trans('hotspot.remove') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                        <i class="ph ph-trash text-xl" aria-hidden="true"></i>
                    </button>
                </form>
                {% endif %}
            </div>
        </div>
        {% endfor %}

        {% if not has_custom %}
        <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-6 text-center dark:border-zinc-700 dark:bg-zinc-800">
            <h2 class="text-sm font-semibold">{{ trans('voucher_templates.empty_title') }}</h2>
            <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
                {{ trans('voucher_templates.empty_text') }}
            </p>
            <a href="{{ url_for('voucher_templates.create') }}" class="mt-3 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600">
                {{ trans('voucher_templates.empty_create') }}
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Desktop: table -->
    <div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block">
        <div class="overflow-x-auto">
            <table class="min-w-full align-middle text-sm">
                <thead>
                    <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('voucher_templates.th_name') }}</th>
                        <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('voucher_templates.th_sections') }}</th>
                        <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('voucher_templates.th_actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for template in templates %}
                    <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2.5">
                                <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-teal-50 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ template.name|first|upper }}</span>
                                <span class="font-medium">{{ template.name }}</span>
                                {% if template.is_default %}
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                                    <span class="size-1.5 rounded-full bg-teal-500"></span>{{ trans('voucher_templates.default') }}
                                </span>
                                {% endif %}
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            {% if template.is_default %}
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ trans('voucher_templates.system_template') }}</span>
                            {% else %}
                            <div class="flex flex-wrap gap-1.5">
                                {% if template.header is not empty %}
                                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ trans('voucher_templates.section_header') }}</span>
                                {% endif %}
                                {% if template.row is not empty %}
                                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ trans('voucher_templates.section_row') }}</span>
                                {% endif %}
                                {% if template.footer is not empty %}
                                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ trans('voucher_templates.section_footer') }}</span>
                                {% endif %}
                                {% if template.header is empty and template.row is empty and template.footer is empty %}
                                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">{{ trans('voucher_templates.section_empty') }}</span>
                                {% endif %}
                            </div>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center justify-end gap-2">
                                <button type="button" @click="open({{ template.id }}, '{{ template.name|e('js') }}', '{{ url_for('voucher_templates.preview_render', {id: template.id})|e('js') }}')" title="{{ trans('voucher_templates.preview') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                    <i class="ph ph-eye text-xl" aria-hidden="true"></i>
                                </button>
                                {% if not template.is_default %}
                                <a href="{{ url_for('voucher_templates.edit', {id: template.id}) }}" title="{{ trans('hotspot.edit') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                    <i class="ph ph-pencil-simple text-xl" aria-hidden="true"></i>
                                </a>
                                <form method="post" action="{{ url_for('voucher_templates.delete', {id: template.id}) }}" x-data="{}" @submit="if (!window.confirm('{{ trans('voucher_templates.remove_confirm', {name: template.name})|e('js') }}')) $event.preventDefault()">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" title="{{ trans('hotspot.remove') }}" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                                        <i class="ph ph-trash text-xl" aria-hidden="true"></i>
                                    </button>
                                </form>
                                {% else %}
                                <span class="text-xs text-zinc-400 dark:text-zinc-500">{{ trans('voucher_templates.read_only') }}</span>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if not has_custom %}
        <div class="border-t border-zinc-100 px-4 py-4 text-center text-sm text-zinc-500 dark:border-zinc-700/50 dark:text-zinc-400">
            {{ trans('voucher_templates.empty_inline') }}
            <a href="{{ url_for('voucher_templates.create') }}" class="font-medium text-teal-600 hover:underline dark:text-teal-400">{{ trans('voucher_templates.empty_create_link') }}</a>
        </div>
        {% endif %}
    </div>

    <!-- Preview profile picker modal -->
    <div
        x-cloak
        x-show="shown"
        x-trap.inert.noscroll="shown"
        @keydown.escape.window="shown = false"
        class="fixed inset-0 z-50 flex items-center justify-center p-4"
    >
        <div x-show="shown" x-transition.opacity @click="shown = false" class="absolute inset-0 bg-zinc-950/50 backdrop-blur-sm" aria-hidden="true"></div>

        <div x-show="shown" x-transition role="dialog" aria-modal="true" class="relative z-10 w-full max-w-md overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-xl dark:border-zinc-700 dark:bg-zinc-800">
            <div class="flex items-center justify-between gap-3 border-b border-zinc-100 px-4 py-3 dark:border-zinc-700/50">
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">{{ trans('voucher_templates.preview') }}</p>
                    <p class="truncate text-xs text-zinc-500 dark:text-zinc-400" x-text="templateName"></p>
                </div>
                <button type="button" @click="shown = false" class="flex h-8 w-8 flex-none items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                    <i class="ph ph-x text-xl" aria-hidden="true"></i>
                </button>
            </div>

            <div class="max-h-[60vh] overflow-y-auto p-4">
                <div x-show="loading" class="flex items-center justify-center gap-2 py-8 text-sm text-zinc-500 dark:text-zinc-400">
                    <i class="ph ph-spinner text-xl animate-spin" aria-hidden="true"></i>
                    {{ trans('voucher_templates.loading_profiles') }}
                </div>

                <template x-if="!loading">
                    <div>
                        <div x-show="isDummy" class="mb-3 flex items-start gap-2.5 rounded-lg border border-dashed border-zinc-300 p-3 text-xs text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
                            <i class="ph ph-info mt-0.5 flex-none text-base" aria-hidden="true"></i>
                            <p>{{ trans('voucher_templates.no_profiles_dummy') }}</p>
                        </div>
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{{ trans('voucher_templates.profiles') }}</p>
                        <div class="flex flex-col gap-2">
                            <template x-for="p in profiles" :key="p.name">
                                <button type="button" @click="printProfile(p)"
                                    class="flex w-full items-center gap-3 rounded-lg border border-zinc-200 bg-white px-3 py-2.5 text-start transition hover:border-teal-400 hover:bg-teal-50/50 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:border-teal-500/50 dark:hover:bg-teal-500/10">
                                    <span class="inline-block h-4 w-4 flex-none rounded-full border border-zinc-300 dark:border-zinc-600" :style="'background-color:' + (p.color || '#14b8a6')"></span>
                                    <span class="min-w-0 flex-1">
                                        <span class="block truncate text-sm font-medium text-zinc-800 dark:text-zinc-200" x-text="p.name"></span>
                                        <span class="block text-xs text-zinc-500 dark:text-zinc-400" x-text="formatPrice(p)"></span>
                                    </span>
                                    <i class="ph ph-arrow-right flex-none text-base text-zinc-400 dark:text-zinc-500" aria-hidden="true"></i>
                                </button>
                            </template>
                        </div>
                        <p class="mt-3 text-center text-xs text-zinc-400 dark:text-zinc-500">{{ trans('voucher_templates.opens_new_tab') }}</p>
                    </div>
                </template>
            </div>
        </div>
    </div>
</div>
{% endblock %}