{% extends "layout.twig" %}

{% block title %}Voucher Templates - Janathan{% endblock %}

{% block content %}
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
        <h1 class="text-2xl font-bold tracking-tight">Voucher Templates</h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Build printable voucher layouts with header, row and footer HTML
        </p>
    </div>
    <a href="{{ url_for('voucher_templates.create') }}"
        class="inline-flex w-fit items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
        <i class="lni lni-plus text-base" aria-hidden="true"></i>
        Add template
    </a>
</div>

{% set has_custom = templates|length > 1 %}

<!-- Mobile: stacked cards -->
<div class="mt-6 grid grid-cols-1 gap-3 md:hidden">
    {% for template in templates %}
    <div class="rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
        <div class="flex items-start justify-between gap-3">
            <div class="flex min-w-0 items-center gap-3">
                <div class="flex h-10 w-10 flex-none items-center justify-center rounded-full {% if template.is_default %}bg-teal-50 text-teal-600 dark:bg-teal-500/10 dark:text-teal-300{% else %}bg-zinc-100 text-zinc-500 dark:bg-zinc-700/50 dark:text-zinc-400{% endif %}">
                    <i class="lni lni-ticket-1 text-xl" aria-hidden="true"></i>
                </div>
                <div class="min-w-0">
                    <p class="flex items-center gap-2 truncate font-semibold">
                        {{ template.name }}
                        {% if template.is_default %}
                        <span class="inline-flex flex-none items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                            <span class="size-1.5 rounded-full bg-teal-500"></span>Default
                        </span>
                        {% endif %}
                    </p>
                    {% if template.is_default %}
                    <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">Built-in system template · read-only</p>
                    {% else %}
                    <p class="text-xs text-zinc-500 dark:text-zinc-400">
                        {{ template.header is not empty ? 'Header' : '—' }} · {{ template.row is not empty ? 'Row' : '—' }} · {{ template.footer is not empty ? 'Footer' : '—' }}
                    </p>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="mt-4 flex items-center gap-2">
            <a href="{{ url_for('voucher_templates.preview', {id: template.id}) }}" title="Preview" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="lni lni-eye text-xl" aria-hidden="true"></i>
            </a>
            {% if not template.is_default %}
            <a href="{{ url_for('voucher_templates.edit', {id: template.id}) }}" title="Edit" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                <i class="lni lni-pencil-1 text-xl" aria-hidden="true"></i>
            </a>
            <form method="post" action="{{ url_for('voucher_templates.delete', {id: template.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove voucher template &quot;{{ template.name }}&quot;?')) $event.preventDefault()">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <button type="submit" title="Remove" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                    <i class="lni lni-trash-3 text-xl" aria-hidden="true"></i>
                </button>
            </form>
            {% endif %}
        </div>
    </div>
    {% endfor %}

    {% if not has_custom %}
    <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-zinc-300 bg-white p-6 text-center dark:border-zinc-700 dark:bg-zinc-800">
        <h2 class="text-sm font-semibold">No custom templates yet</h2>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
            The built-in default is always available. Add your own layout to customize printed vouchers.
        </p>
        <a href="{{ url_for('voucher_templates.create') }}" class="mt-3 rounded-lg bg-teal-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-600">
            Create your first template
        </a>
    </div>
    {% endif %}
</div>

<!-- Desktop: table -->
<div class="mt-6 hidden overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 md:block">
    <div class="overflow-x-auto">
        <table class="min-w-full align-middle text-sm">
            <thead>
                <tr class="border-b border-zinc-100 text-start dark:border-zinc-700/50">
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Name</th>
                    <th class="px-4 py-3 text-start font-semibold text-zinc-900 dark:text-zinc-50">Sections</th>
                    <th class="px-4 py-3 text-end font-semibold text-zinc-900 dark:text-zinc-50">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for template in templates %}
                <tr class="border-t border-zinc-100 even:bg-secondary-50 dark:border-zinc-700/50 dark:even:bg-secondary-900/50">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full bg-teal-50 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ template.name|first|upper }}</span>
                            <span class="font-medium">{{ template.name }}</span>
                            {% if template.is_default %}
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                                <span class="size-1.5 rounded-full bg-teal-500"></span>Default
                            </span>
                            {% endif %}
                        </div>
                    </td>
                    <td class="px-4 py-3">
                        {% if template.is_default %}
                        <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">System template</span>
                        {% else %}
                        <div class="flex flex-wrap gap-1.5">
                            {% if template.header is not empty %}
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">Header</span>
                            {% endif %}
                            {% if template.row is not empty %}
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">Row</span>
                            {% endif %}
                            {% if template.footer is not empty %}
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">Footer</span>
                            {% endif %}
                            {% if template.header is empty and template.row is empty and template.footer is empty %}
                            <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-700/50 dark:text-zinc-400">Empty</span>
                            {% endif %}
                        </div>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ url_for('voucher_templates.preview', {id: template.id}) }}" title="Preview" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                <i class="lni lni-eye text-xl" aria-hidden="true"></i>
                            </a>
                            {% if not template.is_default %}
                            <a href="{{ url_for('voucher_templates.edit', {id: template.id}) }}" title="Edit" class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                                <i class="lni lni-pencil-1 text-xl" aria-hidden="true"></i>
                            </a>
                            <form method="post" action="{{ url_for('voucher_templates.delete', {id: template.id}) }}" x-data="{}" @submit="if (!window.confirm('Remove voucher template &quot;{{ template.name }}&quot;?')) $event.preventDefault()">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <button type="submit" title="Remove" class="flex h-8 w-8 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                                    <i class="lni lni-trash-3 text-xl" aria-hidden="true"></i>
                                </button>
                            </form>
                            {% else %}
                            <span class="text-xs text-zinc-400 dark:text-zinc-500">Read-only</span>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if not has_custom %}
    <div class="border-t border-zinc-100 px-4 py-4 text-center text-sm text-zinc-500 dark:border-zinc-700/50 dark:text-zinc-400">
        No custom templates yet —
        <a href="{{ url_for('voucher_templates.create') }}" class="font-medium text-teal-600 hover:underline dark:text-teal-400">create your first</a>
    </div>
    {% endif %}
</div>
{% endblock %}