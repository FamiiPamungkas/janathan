{% extends "layout.twig" %}

{% block title %}Preview {{ template.name }} - Janathan{% endblock %}

{% block content %}
<script>
window.__previewRouterProfiles = {{ profiles|json_encode|e('js') }};
</script>

<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
        <a href="{{ url_for('voucher_templates.index') }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300">
            <i class="lni lni-arrow-left text-base" aria-hidden="true"></i>
            Back to voucher templates
        </a>
        <h1 class="mt-3 flex items-center gap-2 text-2xl font-bold tracking-tight">
            <span class="truncate">{{ template.name }}</span>
            {% if template.is_default %}
            <span class="inline-flex flex-none items-center gap-1 rounded-full bg-teal-50 px-2 py-0.5 text-xs font-medium text-teal-600 dark:bg-teal-500/10 dark:text-teal-300">
                <span class="size-1.5 rounded-full bg-teal-500"></span>Default
            </span>
            {% endif %}
        </h1>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            Preview with dummy vouchers — 5 per selected profile
        </p>
    </div>
    <div class="flex flex-none items-center gap-2">
        <button type="button" @click="refresh()" class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
            <i class="lni lni-refresh-circle-1-clockwise text-base" aria-hidden="true"></i>
            Refresh
        </button>
        <button type="button" @click="printFrame()" class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-teal-500 px-3.5 py-2 text-sm font-semibold text-white transition hover:bg-teal-600 focus:ring-3 focus:ring-teal-500/30 active:bg-teal-700">
            <i class="lni lni-printer text-base" aria-hidden="true"></i>
            Print
        </button>
    </div>
</div>

{% if errorBanner %}
<div class="mt-6 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
    <i class="lni lni-info mt-0.5 flex-none text-xl" aria-hidden="true"></i>
    <div>
        <p class="text-sm font-semibold">Could not load router profiles</p>
        <p class="mt-0.5 text-sm">{{ errorBanner }}</p>
    </div>
</div>
{% endif %}<div
    x-data="{
        routerProfiles: window.__previewRouterProfiles || [],
        checked: {},
        manual: [{ name: '', color: '#14b8a6', price: '' }],
        iframeSrc: '',
        init() {
            for (const p of this.routerProfiles) {
                this.checked[p.name] = true;
            }
            this.iframeSrc = this.buildUrl();
        },
        buildUrl() {
            const profiles = [];
            for (const p of this.routerProfiles) {
                if (this.checked[p.name]) {
                    profiles.push({ name: p.name, color: p.color, price: p.price });
                }
            }
            for (const m of this.manual) {
                const name = m.name.trim();
                if (name) {
                    profiles.push({ name: name, color: m.color, price: m.price });
                }
            }
            const base = {{ url_for('voucher_templates.preview_render', {id: template.id})|json_encode|e('html_attr') }};
            return base + '?profiles=' + encodeURIComponent(JSON.stringify(profiles));
        },
        refresh() {
            this.iframeSrc = this.buildUrl();
        },
        printFrame() {
            const frame = document.getElementById('preview-frame');
            if (frame && frame.contentWindow) {
                frame.contentWindow.print();
            }
        },
        addManual() {
            this.manual.push({ name: '', color: '#14b8a6', price: '' });
        },
        removeManual(index) {
            this.manual.splice(index, 1);
        },
        selectAll() {
            for (const p of this.routerProfiles) {
                this.checked[p.name] = true;
            }
        },
        clearAll() {
            for (const p of this.routerProfiles) {
                this.checked[p.name] = false;
            }
        }
    }"
>
    <div class="mt-6 rounded-xl border border-zinc-200 bg-white p-4 sm:p-6 dark:border-zinc-700 dark:bg-zinc-800">
        {% if profiles is not empty %}
        <div class="flex items-center justify-between gap-3">
            <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">Profiles from router</p>
            <div class="flex items-center gap-3 text-sm">
                <button type="button" @click="selectAll()" class="font-medium text-teal-600 hover:underline dark:text-teal-400">Select all</button>
                <button type="button" @click="clearAll()" class="font-medium text-zinc-500 hover:underline dark:text-zinc-400">Clear</button>
            </div>
        </div>
        <div class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <template x-for="p in routerProfiles" :key="p.name">
                <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border border-zinc-200 px-3 py-2.5 transition hover:border-zinc-300 dark:border-zinc-700 dark:hover:border-zinc-600">
                    <input type="checkbox" x-model="checked[p.name]" class="h-4 w-4 rounded border-zinc-300 text-teal-500 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900">
                    <span class="inline-block h-4 w-4 flex-none rounded-full border border-zinc-300 dark:border-zinc-600" :style="'background-color:' + (p.color || '#d4d4d8')"></span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-medium text-zinc-800 dark:text-zinc-200" x-text="p.name"></span>
                        <span class="block text-xs text-zinc-500 dark:text-zinc-400" x-text="p.price ? 'Rp ' + Number(p.price).toLocaleString('id-ID') : 'No price'"></span>
                    </span>
                </label>
            </template>
        </div>
        {% else %}
        <div class="flex items-start gap-3 rounded-lg border border-dashed border-zinc-300 p-4 dark:border-zinc-700">
            <i class="lni lni-plug-1 mt-0.5 flex-none text-xl text-zinc-400" aria-hidden="true"></i>
            <div>
                <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">No router connected</p>
                <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400">Add a manual profile below to preview the template.</p>
            </div>
        </div>
        {% endif %}

        <div class="mt-5 border-t border-zinc-100 pt-5 dark:border-zinc-700/50">
            <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-50">Manual profiles</p>
                <button type="button" @click="addManual()" class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-600 hover:underline dark:text-teal-400">
                    <i class="lni lni-plus text-base" aria-hidden="true"></i>
                    Add profile
                </button>
            </div>
            <div class="mt-3 flex flex-col gap-2">
                <template x-for="(m, i) in manual" :key="i">
                    <div class="flex flex-col gap-2 rounded-lg border border-zinc-200 p-3 sm:flex-row sm:items-center dark:border-zinc-700">
                        <input type="text" x-model="m.name" placeholder="Profile name (e.g. Silver)" class="min-w-0 flex-1 rounded-lg border border-zinc-300 px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                        <div class="flex items-center gap-2">
                            <input type="color" x-model="m.color" class="h-9 w-12 flex-none cursor-pointer rounded-lg border border-zinc-300 bg-white p-1 dark:border-zinc-600 dark:bg-zinc-900">
                            <input type="number" x-model="m.price" min="0" placeholder="Price" class="w-28 rounded-lg border border-zinc-300 px-3 py-2 text-sm text-zinc-900 placeholder-zinc-400 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/30 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
                            <button type="button" @click="removeManual(i)" x-show="manual.length > 1" class="flex h-9 w-9 flex-none items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:border-red-300 hover:bg-red-50 dark:border-red-500/30 dark:bg-zinc-800 dark:text-red-400 dark:hover:bg-red-500/10">
                                <i class="lni lni-xmark text-xl" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800">
        <iframe id="preview-frame" :src="iframeSrc" title="Voucher template preview" class="block h-[70vh] w-full border-0 bg-white"></iframe>
    </div>
</div>
{% endblock %}
