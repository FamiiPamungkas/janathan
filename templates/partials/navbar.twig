            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-500 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                    <path fill-rule="evenodd" d="M1 7.25A2.25 2.25 0 0 1 3.25 5h13.5A2.25 2.25 0 0 1 19 7.25v5.5A2.25 2.25 0 0 1 16.75 15H3.25A2.25 2.25 0 0 1 1 12.75v-5.5Zm1.5 0c0-.414.336-.75.75-.75h13.5c.414 0 .75.336.75.75v5.5c0 .414-.336.75-.75.75H3.25a.75.75 0 0 1-.75-.75v-5.5ZM5 9.75a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 5 9.75Z" clip-rule="evenodd" />
