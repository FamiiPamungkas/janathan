<nav class="sticky top-0 z-40 border-b border-zinc-200 bg-white/80 backdrop-blur-sm dark:border-zinc-700/50 dark:bg-zinc-900/80">
    <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
        <div class="flex min-w-0 flex-1 items-center gap-2.5">
            <a href="{{ url_for('dashboard') }}" class="hidden flex-none items-center gap-2.5 sm:flex">
                <div class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-teal-500 text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                        <path fill-rule="evenodd" d="M1 7.25A2.25 2.25 0 0 1 3.25 5h13.5A2.25 2.25 0 0 1 19 7.25v5.5A2.25 2.25 0 0 1 16.75 15H3.25A2.25 2.25 0 0 1 1 12.75v-5.5Zm1.5 0c0-.414.336-.75.75-.75h13.5c.414 0 .75.336.75.75v5.5c0 .414-.336.75-.75.75H3.25a.75.75 0 0 1-.75-.75v-5.5ZM5 9.75a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 5 9.75Z" clip-rule="evenodd" />
                    </svg>
                </div>
                <span class="text-lg font-bold tracking-tight">Janathan</span>
            </a>

            <!-- Router selector -->
            <div x-data="{ open: false }" class="relative min-w-0 max-w-full">
                <button @click="open = !open" type="button" class="flex w-auto max-w-full items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-sm font-medium text-zinc-700 transition hover:border-zinc-300 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:border-zinc-600">
                    {% if active_router %}
                        <span class="size-2 flex-none rounded-full bg-teal-500"></span>
                        <span class="min-w-0 max-w-full truncate sm:max-w-40">{{ active_router.name }}</span>
                    {% else %}
                        <span class="size-2 flex-none rounded-full bg-zinc-400"></span>
                        <span>Select router</span>
                    {% endif %}
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3 flex-none opacity-60">
                        <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <div x-show="open" x-cloak @click.outside="open = false" class="absolute left-0 top-full z-50 mt-1 w-64 overflow-hidden rounded-xl border border-zinc-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
                    <p class="px-3 py-1.5 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">Routers</p>
                    {% if routers is empty %}
                        <a href="{{ url_for('routers.create') }}" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-teal-600 dark:text-teal-400">Add your first router</a>
                    {% endif %}
                    {% for router in routers %}
                        <form method="post" action="{{ url_for('routers.connect', {id: router.id}) }}">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                            <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 text-start text-sm hover:bg-zinc-50 dark:hover:bg-zinc-700/40">
                                {% if active_router and active_router.id == router.id %}
                                    <span class="size-2 flex-none rounded-full bg-teal-500"></span>
                                {% else %}
                                    <span class="size-2 flex-none rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
                                {% endif %}
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate font-medium text-zinc-800 dark:text-zinc-200">{{ router.name }}</span>
                                    <span class="block truncate font-mono text-xs text-zinc-500 dark:text-zinc-400">{{ router.host }}</span>
                                </span>
                            </button>
                        </form>
                    {% endfor %}
                    <div class="mt-1 border-t border-zinc-100 dark:border-zinc-700/50">
                        <a href="{{ url_for('routers.index') }}" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-teal-600 dark:text-teal-400">Manage routers</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-none items-center gap-2">
            <!-- User menu -->
            <div
                x-data="{
                    open: false,
                    darkModePreference: 'system',
                    useLocalStorage: true,
                    localStorageKey: 'dark-mode',
                    init() {
                        if (this.useLocalStorage) {
                            this.darkModePreference = this.loadDarkModePreference();
                        }
                        this.applyDarkMode();
                        if (window.matchMedia) {
                            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
                                if (this.darkModePreference === 'system') {
                                    this.applyDarkMode();
                                }
                            });
                        }
                    },
                    loadDarkModePreference() {
                        let stored = null;
                        try { stored = localStorage.getItem(this.localStorageKey); } catch (e) {}
                        if (stored === 'on' || stored === 'off' || stored === 'system') {
                            return stored;
                        }
                        return this.darkModePreference;
                    },
                    applyDarkMode() {
                        let darkModeActive;
                        if (this.darkModePreference === 'system') {
                            darkModeActive = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        } else {
                            darkModeActive = this.darkModePreference === 'on';
                        }
                        document.documentElement.classList.toggle('dark', darkModeActive);
                    },
                    setDarkMode(value) {
                        this.darkModePreference = value;
                        if (this.useLocalStorage) {
                            try { localStorage.setItem(this.localStorageKey, value); } catch (e) {}
                        }
                        this.applyDarkMode();
                    },
                    cycleDarkMode() {
                        const next = { 'off': 'system', 'system': 'on', 'on': 'off' };
                        this.setDarkMode(next[this.darkModePreference]);
                    }
                }"
                class="relative"
            >
                <button @click="open = !open" type="button" class="flex items-center gap-1.5 rounded-full p-1 ring-1 ring-zinc-200 transition hover:bg-zinc-50 dark:ring-zinc-700 dark:hover:bg-zinc-800">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-teal-100 text-xs font-semibold text-teal-700 dark:bg-teal-500/10 dark:text-teal-300">{{ current_user.username|first|upper }}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="mr-1 hidden size-3 text-zinc-500 sm:block dark:text-zinc-400">
                        <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                </button>
                <div x-show="open" x-cloak @click.outside="open = false" class="absolute right-0 top-full z-50 mt-1 w-48 overflow-hidden rounded-xl border border-zinc-200 bg-white py-1 shadow-lg dark:border-zinc-700 dark:bg-zinc-800">
                    <p class="px-3 py-1.5 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">{{ current_user.username }}</p>
                    <a href="{{ url_for('routers.index') }}" class="flex items-center gap-2 px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-700/40">
                        Manage routers
                    </a>
                    <!-- Theme toggle -->
                    <button @click="cycleDarkMode()" type="button" class="flex w-full items-center gap-2 px-3 py-2 text-start text-sm text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-zinc-700/40">
                        <span class="relative size-4 flex-none">
                            <svg x-show="darkModePreference === 'off'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-0 size-4"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
                            <svg x-show="darkModePreference === 'system'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-0 size-4"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                            <svg x-show="darkModePreference === 'on'" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute inset-0 size-4"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
                        </span>
                        <span class="flex-1">Theme</span>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400" x-text="{ 'off': 'Light', 'system': 'System', 'on': 'Dark' }[darkModePreference]"></span>
                    </button>
                    <form method="post" action="{{ url_for('logout') }}" class="border-t border-zinc-100 dark:border-zinc-700/50">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <button type="submit" class="w-full px-3 py-2 text-start text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10">Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</nav>
