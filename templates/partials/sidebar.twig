{% set current_path = path_info() %}
{% set dashboard_active = current_path starts with '/dashboard' %}
{% set hotspot_active = current_path starts with '/hotspot' %}
{% set users_active = current_path starts with '/hotspot/users' %}
{% set profiles_active = current_path starts with '/hotspot/profiles' %}

<!-- Mobile overlay -->
<div x-show="sidebarOpen" x-cloak x-transition.opacity @click="sidebarOpen = false" class="fixed inset-0 z-40 bg-zinc-950/50 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>

<!-- Sidebar -->
<aside
    x-trap.inert.noscroll="sidebarOpen && window.innerWidth < 1024"
    :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
    class="fixed inset-y-0 left-0 z-50 flex w-48 flex-col border-r border-zinc-200 bg-white transition-transform duration-300 ease-in-out dark:border-zinc-700 dark:bg-zinc-900 lg:sticky lg:top-16 lg:z-auto lg:h-[calc(100vh-4rem)] lg:translate-x-0"
>
    <!-- Mobile header -->
    <div class="flex h-16 flex-none items-center justify-between gap-3 border-b border-zinc-200 px-4 dark:border-zinc-700 lg:hidden">
        <a href="{{ url_for('dashboard') }}" class="flex flex-none items-center gap-2.5">
            <div class="flex h-8 w-8 flex-none items-center justify-center rounded-lg bg-teal-500 text-white">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                    <path fill-rule="evenodd" d="M1 7.25A2.25 2.25 0 0 1 3.25 5h13.5A2.25 2.25 0 0 1 19 7.25v5.5A2.25 2.25 0 0 1 16.75 15H3.25A2.25 2.25 0 0 1 1 12.75v-5.5Zm1.5 0c0-.414.336-.75.75-.75h13.5c.414 0 .75.336.75.75v5.5c0 .414-.336.75-.75.75H3.25a.75.75 0 0 1-.75-.75v-5.5ZM5 9.75a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5h-8.5A.75.75 0 0 1 5 9.75Z" clip-rule="evenodd" />
                </svg>
            </div>
            <span class="text-lg font-bold tracking-tight">Janathan</span>
        </a>
        <button type="button" @click="sidebarOpen = false" aria-label="Close navigation" class="flex h-8 w-8 flex-none items-center justify-center rounded-lg border border-zinc-200 bg-white text-zinc-600 transition hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-600 dark:hover:text-zinc-100">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
            </svg>
        </button>
    </div>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto p-3">
        <div class="flex flex-col gap-1">
            <p class="px-3 pb-2 text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">Menu</p>

            <!-- Dashboard -->
            <a href="{{ url_for('dashboard') }}" class="group flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium {% if dashboard_active %}bg-zinc-100 text-zinc-950 dark:bg-zinc-700/60 dark:text-white{% else %}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-700/60 dark:hover:text-white{% endif %}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 flex-none opacity-40 group-hover:opacity-80">
                    <path fill-rule="evenodd" d="M3.5 2A1.5 1.5 0 0 0 2 3.5V6A1.5 1.5 0 0 0 3.5 7.5H6A1.5 1.5 0 0 0 7.5 6V3.5A1.5 1.5 0 0 0 6 2H3.5ZM11.5 2A1.5 1.5 0 0 0 10 3.5V6a1.5 1.5 0 0 0 1.5 1.5H14A1.5 1.5 0 0 0 15.5 6V3.5A1.5 1.5 0 0 0 14 2h-2.5ZM3.5 10.5A1.5 1.5 0 0 0 2 12v2.5A1.5 1.5 0 0 0 3.5 16H6a1.5 1.5 0 0 0 1.5-1.5V12A1.5 1.5 0 0 0 6 10.5h-2.5ZM11.5 10.5A1.5 1.5 0 0 0 10 12v2.5a1.5 1.5 0 0 0 1.5 1.5H14a1.5 1.5 0 0 0 1.5-1.5V12a1.5 1.5 0 0 0-1.5-1.5h-2.5Z" clip-rule="evenodd" />
                </svg>
                <span class="truncate">Dashboard</span>
            </a>

            <!-- Hotspot -->
            <div x-data="{ open: {{ hotspot_active ? 'true' : 'false' }} }">
                <button type="button" @click="open = !open" aria-expanded="open" class="group flex w-full items-center justify-between rounded-xl px-3 py-2 text-sm font-medium {% if hotspot_active %}bg-zinc-100 text-zinc-950 dark:bg-zinc-700/60 dark:text-white{% else %}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-700/60 dark:hover:text-white{% endif %}">
                    <span class="flex flex-1 items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 flex-none opacity-40 group-hover:opacity-80">
                            <path fill-rule="evenodd" d="M2.78 7.5a10.5 10.5 0 0 1 14.44 0 .75.75 0 0 0 1.06-1.06 12 12 0 0 0-16.56 0 .75.75 0 0 0 1.06 1.06ZM4.44 10.5a6.5 6.5 0 0 1 11.12 0 .75.75 0 0 0 1.253-.833 8 8 0 0 0-13.626 0 .75.75 0 0 0 1.253.833ZM7.5 13.5a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0ZM10 3a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0v-2.5A.75.75 0 0 1 10 3Z" clip-rule="evenodd" />
                        </svg>
                        <span class="truncate">Hotspot</span>
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 flex-none opacity-40 transition-transform" :class="open ? 'rotate-180' : ''">
                        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                    </svg>
                </button>

                <div x-show="open" x-cloak class="ms-6 mt-1 flex flex-col gap-0.5">
                    <a href="{{ url_for('hotspot.users') }}" class="group flex items-center gap-3 rounded-md px-3 py-1.5 text-sm {% if users_active %}bg-zinc-100 text-zinc-900 dark:bg-zinc-700/60 dark:text-white{% else %}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-700/60 dark:hover:text-white{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 flex-none opacity-40 group-hover:opacity-80">
                            <path d="M7 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM14.5 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM1.615 16.428a1.224 1.224 0 0 1-.569-1.175 6.002 6.002 0 0 1 11.908 0c.058.467-.172.92-.57 1.174A9.953 9.953 0 0 1 7 18a9.953 9.953 0 0 1-5.385-1.572ZM14.5 16h-.106c.07-.297.088-.611.048-.933a7.47 7.47 0 0 0-1.588-3.755 4.502 4.502 0 0 1 5.874 2.636.818.818 0 0 1-.36.98A7.465 7.465 0 0 1 14.5 16Z" />
                        </svg>
                        <span class="truncate">User List</span>
                    </a>

                    <a href="{{ url_for('hotspot.profiles') }}" class="group flex items-center gap-3 rounded-md px-3 py-1.5 text-sm {% if profiles_active %}bg-zinc-100 text-zinc-900 dark:bg-zinc-700/60 dark:text-white{% else %}text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-700/60 dark:hover:text-white{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 flex-none opacity-40 group-hover:opacity-80">
                            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                        </svg>
                        <span class="truncate">Profile List</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</aside>
