<!DOCTYPE html>
<html lang="{{ locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Janathan{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('/css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('/fonts/phosphor/style.css') }}">
    <link rel="icon" href="{{ asset('/favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('/apple-touch-icon.png') }}">
    <script>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('dark-mode'); } catch (e) {}
            var dark = stored === 'on'
                || (stored !== 'off' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
        })();
    </script>
    <script defer src="{{ asset('/js/app.js') }}"></script>
</head>
<body class="bg-zinc-100 text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100" x-data="{ sidebarOpen: false }" @keydown.escape.window="sidebarOpen = false">
    {% block nav %}
        {% include 'partials/navbar.twig' %}
    {% endblock %}

    <div class="lg:flex">
        {% block sidebar %}
            {% include 'partials/sidebar.twig' %}
        {% endblock %}

        <div class="min-w-0 flex-1">
            <main class="mx-auto w-full max-w-7xl px-4 pb-10 pt-6 sm:px-6 lg:px-8">
                {% set messages = flash() %}
                {% if messages is not empty %}
                    <div class="mb-6 space-y-3">
                        {% for message in messages %}
                            <div class="flex items-start gap-3 rounded-xl border p-4 text-sm
                                {% if message.type == 'error' %}border-red-200 bg-red-50 text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-200{% else %}border-teal-200 bg-teal-50 text-teal-800 dark:border-teal-500/30 dark:bg-teal-500/10 dark:text-teal-200{% endif %}">
                                <i class="ph flex-none text-xl {% if message.type == 'error' %}ph-x-circle text-red-500{% else %}ph-check-circle text-teal-500{% endif %}" aria-hidden="true"></i>
                                <p>{{ message.message }}</p>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% block content %}{% endblock %}
            </main>

            {% include 'partials/footer.twig' %}
        </div>
    </div>

    {% block scripts %}{% endblock %}
</body>
</html>
