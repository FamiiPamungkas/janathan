MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=
MIKROTIK_PORT=8728
MIKROTIK_SSL=false

# RouterOS API timeout in seconds — applies to both the TCP connect timeout
# and the read (socket) timeout. Lower this to fail faster when a router is
# unreachable. Used by RouterosClientFactory as the default for all connections.
MIKROTIK_TIMEOUT=5

APP_ENV=development
APP_DEBUG=true
APP_NAME=Janathan

# Generate with: openssl rand -hex 32
APP_KEY=
# SQLite database file (relative to project root)
DB_PATH=database/janathan.sqlite

# Base URL of this machine's dev server, e.g. http://<your-lan-ip>:8080
APP_URL=http://localhost:8080
