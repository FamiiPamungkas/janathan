# RouterOS API timeout in seconds — applies to the TCP connect timeout.
# Lower this to fail faster when a router is unreachable.
MIKROTIK_TIMEOUT=5

# Read (socket) timeout in seconds for a single API reply. RouterOS streams a
# whole response, so on weak hardware a slow query (e.g. active sessions with
# stats, or the log) can exceed the connect timeout — give it more headroom.
# Defaults to 30 if unset.
MIKROTIK_SOCKET_TIMEOUT=30

# Number of TCP connect attempts before giving up. Defaults to 5 if unset.
MIKROTIK_ATTEMPTS=5

APP_ENV=development
APP_DEBUG=true
APP_NAME=Janathan

# SQLite database file (relative to project root)
DB_PATH=database/janathan.sqlite

# Base URL of this machine's dev server, e.g. http://<your-lan-ip>:8080
APP_URL=http://localhost:8080

# Sub-path the app is mounted under (e.g. /janathan when it lives in a
# subfolder of the web root). Leave empty when the document root points
# directly at the public/ folder.
APP_BASE_PATH=
